# NOTE: npm is NOT used to manage project dependencies.
# All project dependencies must be installed via pnpm (e.g. `make node_modules`).
# npm is used only for:
#   - Bootstrapping pnpm itself (e.g. `npm install -g --min-release-age=14 "pnpm@^10.34.3"` in the Dockerfile)
#   - Installing specific standalone CLI tools in CI workflows
#     (e.g. `@charmland/crush` in .github/workflows/pull-review-crush.yml)

audit=false
fund=false
update-notifier=false
save-exact=true
auto-install-peers=true
dedupe-peer-dependents=false
enable-pre-post-scripts=true
min-release-age=14
