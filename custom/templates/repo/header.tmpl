{{/* #469: the subject header, the same on every view (Bubble, Table, Article) and every
     article tab (Read, Edit, History): the title block (figma Frame 168 7368:260781, 136px:
     24px above and below, the 56px title and the 32px Follow with no gap) and the view
     tabs row (UnderNav_Views 7368:260789, 48px), both 1344px wide at 1440 (48px margins,
     24 on a tablet, 16 on a phone). Its sizes are in web_src/css/repo/header.css; the info
     bars above it stay in the flow and push it down by their height. */}}
<div class="secondary-nav subject-header">
{{with .Repository}}
	<div class="ui container subject-header-container">
		<div class="repo-header tw-flex tw-flex-col tw-items-center repo-header-with-follow">
			<h1 class="tw-text-40 tw-m-0">{{$.SubjectName}}</h1>
			<!-- Does header need to be a link?
				<a class="muted" href="{{$.RepoLink}}"></a>
			-->
			{{/* Follow is offered on every subject, to everyone (#421 item 5). It used to be
			     hidden from the owner of the article shown, so a signed-in reader lost it on
			     every subject they had created themselves (the recently created ones). */}}
			{{/* ...on every page that says where to post it (RepoOperationsLink) */}}
			{{if $.RepoOperationsLink}}
			<div class="repo-header-follow">
				{{/* the article the star is for, which the Article view's Watch button sends
				     so that its answer can update the star too (routers/web/repo/watch.go) */}}
				{{if $.IsSigned}}<input type="hidden" id="repo-header-follow-sync" name="sync_follow_repo" value="{{.ID}}">{{end}}
				<div id="repo-header-follow-slot">{{template "repo/watch_unwatch" $}}</div>
			</div>
			{{end}}
		</div>
	</div>
{{end}}
	{{$subjectUrl := printf "%s/subject/%s" AppSubUrl (PathEscape .SubjectName)}}
	{{$bubbleUrl := QueryBuild $subjectUrl "view" "bubble" "selected" .SubjectSelected}}
	<div class="ui container subject-header-container">
		<overflow-menu class="ui secondary pointing menu">
			<div class="overflow-menu-items tw-justify-center" id="subject-view-tabs" data-owner="{{.Repository.Owner.Name}}" data-subject="{{.SubjectName}}">
				<a class="{{if .IsBubbleView}}active {{end}}item" href="{{$bubbleUrl}}" data-view="bubble">
					{{svg "bubble"}} Bubble<span class="not-mobile tw-ml-1">view</span>
				</a>
				<a class="{{if .IsTableView}}active {{end}}item" href="{{QueryBuild $subjectUrl "view" "table" "selected" .SubjectSelected}}" data-view="table">
					{{svg "octicon-table"}} Table<span class="not-mobile tw-ml-1">view</span>
				</a>
				<a class="{{if .IsArticleView}}active {{end}}item" href="{{QueryBuild $subjectUrl "view" "article" "selected" .SubjectSelected}}" data-view="article" id="article-view-link">
					{{svg "octicon-file"}} Article<span class="not-mobile tw-ml-1">view</span>
				</a>
			</div>
			{{/* Its label and state follow Compare mode (#421 item 1): web_src/js/features/copycontent.ts
			     swaps the label for data-label-on while it is on, and marks it unavailable, with
			     data-unavailable as its tooltip, on a subject with a single article. On a page
			     without the subject views it opens data-bubble-url with the press. Its icon is
			     figma's file-diff-24 drawn at 16px (component 319:1637 in the button 484:188986),
			     not the 16px octicon, whose glyph differs. */}}
			<button class="ui button tiny compact" id="compare-mode-button" type="button" aria-pressed="false"
				data-global-click="onCompareModeToggle"
				data-bubble-url="{{$bubbleUrl}}"
				data-label-off="{{ctx.Locale.Tr "repo.compare_mode"}}"
				data-label-on="{{ctx.Locale.Tr "repo.compare_mode_on"}}"
				data-unavailable="{{ctx.Locale.Tr "repo.compare_mode_unavailable"}}"
				{{/* that tooltip is figma's Tooltip (7368:260912, #451): below the button, flush
				     with its right edge, in the forkana theme (web_src/css/modules/tippy.css) */}}
				data-tooltip-placement="bottom-end" data-tooltip-theme="forkana"
				aria-label="{{ctx.Locale.Tr "repo.compare_mode"}}">
				{{svg "forkana-file-diff-24" 16}}<span class="not-mobile tw-ml-1" data-role="compare-label">{{ctx.Locale.Tr "repo.compare_mode"}}</span>
			</button>
		</overflow-menu>
	</div>
</div>
