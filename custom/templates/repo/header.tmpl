<div class="secondary-nav">
{{with .Repository}}
	{{$canFollow := not (and $.IsSigned (eq $.SignedUser.ID .OwnerID))}}
	<div class="ui container">
		<div class="repo-header tw-flex tw-flex-col tw-items-center tw-pt-14 {{if $canFollow}}repo-header-with-follow{{else}}tw-pb-10{{end}}">
			<h1 class="tw-text-40 tw-m-0">{{$.SubjectName}}</h1>
			<!-- Does header need to be a link?
				<a class="muted" href="{{$.RepoLink}}"></a>
			-->
			{{if $canFollow}}
				<div class="repo-header-follow">
					{{template "repo/watch_unwatch" $}}
				</div>
			{{end}}
		</div>
	</div>
{{end}}
	<div class="ui container">
		<overflow-menu class="ui secondary pointing menu">
			<div class="overflow-menu-items tw-justify-center" id="subject-view-tabs" data-owner="{{.Repository.Owner.Name}}" data-subject="{{.SubjectName}}">
				<a class="{{if .IsBubbleView}}active {{end}}item" href="{{QueryBuild (printf "%s/subject/%s" AppSubUrl (PathEscape .SubjectName)) "view" "bubble" "selected" .SubjectSelected}}" data-view="bubble">
					{{svg "bubble"}} Bubble<span class="not-mobile tw-ml-1">view</span>
				</a>
				<a class="{{if .IsTableView}}active {{end}}item" href="{{QueryBuild (printf "%s/subject/%s" AppSubUrl (PathEscape .SubjectName)) "view" "table" "selected" .SubjectSelected}}" data-view="table">
					{{svg "octicon-table"}} Table<span class="not-mobile tw-ml-1">view</span>
				</a>
				<a class="{{if .IsArticleView}}active {{end}}item" href="{{QueryBuild (printf "%s/subject/%s" AppSubUrl (PathEscape .SubjectName)) "view" "article" "selected" .SubjectSelected}}" data-view="article" id="article-view-link">
					{{svg "octicon-file"}} Article<span class="not-mobile tw-ml-1">view</span>
				</a>
			</div>
			{{/* Its label and state follow Compare mode (#421 item 1): web_src/js/features/copycontent.ts
			     swaps the label for data-label-on while it is on, and marks it unavailable, with
			     data-unavailable as its tooltip, on a subject with a single article. On a page
			     without the subject views it opens data-bubble-url with the press. */}}
			<button class="ui button tiny compact tw-h-9" id="compare-mode-button" type="button" aria-pressed="false"
				data-global-click="onCompareModeToggle"
				data-bubble-url="{{QueryBuild (printf "%s/subject/%s" AppSubUrl (PathEscape .SubjectName)) "view" "bubble" "selected" .SubjectSelected}}"
				data-label-off="{{ctx.Locale.Tr "repo.compare_mode"}}"
				data-label-on="{{ctx.Locale.Tr "repo.compare_mode_on"}}"
				data-unavailable="{{ctx.Locale.Tr "repo.compare_mode_unavailable"}}"
				aria-label="{{ctx.Locale.Tr "repo.compare_mode"}}">
				{{svg "octicon-file-diff" 16}}<span class="not-mobile tw-ml-1" data-role="compare-label">{{ctx.Locale.Tr "repo.compare_mode"}}</span>
			</button>
		</overflow-menu>
	</div>
</div>
