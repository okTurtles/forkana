{{/* Custom diff box for the conflict resolution page. Based on box.tmpl but simplified:
     - No file tree toggle / panel
     - "N Conflicts" header instead of stats
     - No options dropdown / expand-collapse
     - No review submit modal
     - Adds Submit button + fold toggle
     - Uses conflicts_section_split for rendering */}}
<div>
	<div class="diff-detail-box">
		<div class="tw-flex tw-items-center tw-flex-wrap tw-gap-2 tw-ml-0.5">
			{{if not .DiffNotAvailable}}
				<div class="diff-detail-stats conflicts-stats-header tw-flex tw-items-center tw-flex-wrap">
					<strong class="tw-text-red">{{ctx.Locale.TrN .DiffShortStat.NumFiles "repo.diff.conflicts_count_1" "repo.diff.conflicts_count_n" .DiffShortStat.NumFiles}}</strong>
				</div>
			{{end}}
		</div>
		{{if not .DiffNotAvailable}}
			<div class="diff-detail-actions tw-flex tw-items-center tw-gap-2">
				<button type="button" class="ui tiny basic button conflict-fold-toggle-btn" data-tooltip-content="{{ctx.Locale.Tr "repo.pulls.conflicts_toggle_context"}}" title="{{ctx.Locale.Tr "repo.pulls.conflicts_toggle_context"}}">
					{{svg "octicon-fold" 16}}
				</button>
				<button type="button" class="ui tiny primary button conflict-submit-btn" disabled>{{ctx.Locale.Tr "repo.pulls.conflicts_submit"}}</button>
			</div>
		{{end}}
	</div>
	{{if not .DiffNotAvailable}}
		<div id="diff-container">
			<div id="diff-file-boxes" class="sixteen wide column conflict-diff-file-boxes" data-base-commit-id="{{$.BeforeCommitID}}" data-head-commit-id="{{$.AfterCommitID}}" data-whitespace="{{$.WhitespaceBehavior}}"
				{{/* the strings of web_src/js/features/repo-conflict-review.ts (keys in repo-conflict-i18n.ts) */}}
				data-i18n="{{JsonUtils.EncodeToString (dict
					"repo.pulls.conflicts_counter" (ctx.Locale.Tr "repo.pulls.conflicts_counter")
					"repo.pulls.conflicts_prev" (ctx.Locale.Tr "repo.pulls.conflicts_prev")
					"repo.pulls.conflicts_next" (ctx.Locale.Tr "repo.pulls.conflicts_next")
					"repo.pulls.conflicts_keep" (ctx.Locale.Tr "repo.pulls.conflicts_keep")
					"repo.pulls.conflicts_use" (ctx.Locale.Tr "repo.pulls.conflicts_use")
					"repo.pulls.conflicts_resolve" (ctx.Locale.Tr "repo.pulls.conflicts_resolve")
					"repo.pulls.conflicts_resolved_button" (ctx.Locale.Tr "repo.pulls.conflicts_resolved_button")
					"repo.pulls.conflicts_resolved" (ctx.Locale.Tr "repo.pulls.conflicts_resolved")
					"repo.pulls.conflicts_resolved_more_1" (ctx.Locale.Tr "repo.pulls.conflicts_resolved_more_1")
					"repo.pulls.conflicts_resolved_more_n" (ctx.Locale.Tr "repo.pulls.conflicts_resolved_more_n")
					"repo.pulls.conflicts_edit" (ctx.Locale.Tr "repo.pulls.conflicts_edit")
					"repo.pulls.conflicts_show_context" (ctx.Locale.Tr "repo.pulls.conflicts_show_context")
					"repo.pulls.conflicts_hide_context" (ctx.Locale.Tr "repo.pulls.conflicts_hide_context")
					"repo.pulls.conflicts_submitting" (ctx.Locale.Tr "repo.pulls.conflicts_submitting")
					"repo.pulls.conflicts_submit_failed" (ctx.Locale.Tr "repo.pulls.conflicts_submit_failed")
					"repo.pulls.conflicts_submit_network_error" (ctx.Locale.Tr "repo.pulls.conflicts_submit_network_error")
					"repo.pulls.conflicts_init_failed" (ctx.Locale.Tr "repo.pulls.conflicts_init_failed")
					"repo.pulls.conflicts_draft_title" (ctx.Locale.Tr "repo.pulls.conflicts_draft_title")
					"repo.pulls.conflicts_draft_text" (ctx.Locale.Tr "repo.pulls.conflicts_draft_text")
					"repo.pulls.conflicts_draft_restore" (ctx.Locale.Tr "repo.pulls.conflicts_draft_restore")
					"repo.pulls.conflicts_draft_dismiss" (ctx.Locale.Tr "repo.pulls.conflicts_draft_dismiss")
				)}}">
				{{range $i, $file := .Diff.Files}}
					<div class="diff-file-box file-content {{TabSizeClass $.Editorconfig $file.Name}} tw-mt-0" id="diff-{{$file.NameHash}}" data-old-filename="{{$file.OldName}}" data-new-filename="{{$file.Name}}" data-file-delete-choice="{{if $file.IsDeleted}}use{{else if $file.IsCreated}}keep{{else}}none{{end}}">
						<div class="diff-file-body ui attached unstackable table segment">
							<div id="diff-source-{{$file.NameHash}}" class="file-body file-code unicode-escaped code-diff code-diff-split">
								{{if or $file.IsIncomplete $file.IsBin}}
									<div class="diff-file-body binary">
										{{if $file.IsIncomplete}}
											{{ctx.Locale.Tr "repo.diff.file_suppressed"}}
										{{else}}
											{{ctx.Locale.Tr "repo.diff.bin_not_shown"}}
										{{end}}
									</div>
								{{else}}
									<table class="chroma" data-path="{{$file.Name}}">
										{{template "repo/diff/conflicts_section_split" dict "file" . "root" $}}
									</table>
								{{end}}
							</div>
						</div>
					</div>
				{{end}}
			</div>
		</div>
		<div class="tw-flex tw-justify-end tw-mt-4 tw-mb-4">
			<button type="button" class="ui primary button tiny conflict-submit-btn" disabled>{{ctx.Locale.Tr "repo.pulls.conflicts_submit"}}</button>
		</div>
	{{/* General diff/render failures may provide a complete message. */}}
	{{else if .ConflictResolutionUnavailableMessage}}
		<div class="ui warning message">
			{{.ConflictResolutionUnavailableMessage}}
		</div>
	{{/* Unsupported conflicts use localized support/moderator guidance without exposing filenames. */}}
	{{else if .ConflictResolutionUnavailable}}
		<div class="ui warning message">
			{{ctx.Locale.Tr "repo.pulls.conflicts_unsupported_file"}}
		</div>
	{{else}}
		<h4>{{ctx.Locale.Tr "repo.diff.data_not_available"}}</h4>
	{{end}}

	{{if and (not $.Repository.IsArchived) (not .DiffNotAvailable)}}
		<template id="issue-comment-editor-template">
			<form class="ui form comment">
				<div class="field">
				{{template "shared/toasteditor" (dict
					"TextareaName" "content"
					"DropzoneParentContainer" ".ui.form"
					"PreviewUrl" (print $.Repository.Link "/markup")
					"PreviewContext" $.Repository.Link
				)}}
				{{if .IsAttachmentEnabled}}
					{{template "repo/upload" .}}
					<div class="dropzone-hint-text">{{ctx.Locale.Tr "dropzone.default_message"}}</div>
				{{end}}
				</div>
				<div class="field flex-text-block tw-justify-end">
					<button class="ui cancel button">{{ctx.Locale.Tr "repo.issues.cancel"}}</button>
					<button class="ui primary button">{{ctx.Locale.Tr "repo.issues.save"}}</button>
				</div>
			</form>
		</template>
	{{end}}
	{{if (not .DiffNotAvailable)}}
		{{template "shared/user/block_user_dialog" .}}
	{{end}}
</div>
