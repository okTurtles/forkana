{{/* The Article view's Watch button, at the end of the tabs' row (#433 item 3, figma
     "View Tab" 641:65480, its trailing "Action" I641:65480;8575:17229;24375:95729), for the
     ARTICLE (#165): watching it sends notifications and emails when a change request is
     opened, commented on or merged (figma note 7368:414649). It is independent of the
     subject header's Follow (repo/subject_follow), which feeds the dashboard. An eye-24
     icon and an Inter 600 14/20 #25292e label in a borderless 6/12-padded button: "Watch"
     with a #1f2328 eye (Button I7368:416164;24375:95729 in "Read full article" 7368:416141),
     "Unwatch" with a brand purple one while the article is watched (I7368:416282;24375:95729
     in 7368:416259). It posts with style=button so that ActionWatch answers with this
     template. On a phone it is an icon that opens the Watch menu below ("Watch menu"
     7368:416644). A signed-out reader is sent to sign in. */}}
{{if $.IsSigned}}
{{$watchLink := printf "%s/action/watch?style=button" $.RepoOperationsLink}}
{{$unwatchLink := printf "%s/action/unwatch?style=button" $.RepoOperationsLink}}
<div class="article-watch-control">
	<form class="article-watch-form" hx-boost="true" hx-target="closest .article-watch-control" hx-swap="outerHTML" method="post" action="{{if $.IsWatchingRepo}}{{$unwatchLink}}{{else}}{{$watchLink}}{{end}}">
		{{/* (on a phone, onArticleWatchClick opens the menu instead of posting) */}}
		<button type="submit" class="forkana-btn forkana-btn-tertiary article-action-button" data-role="article-watch" data-watching="{{if $.IsWatchingRepo}}true{{else}}false{{end}}" data-global-click="onArticleWatchClick">
			{{svg "octicon-eye" 16}}
			<span>{{if $.IsWatchingRepo}}{{ctx.Locale.Tr "repo.unwatch"}}{{else}}{{ctx.Locale.Tr "repo.watch"}}{{end}}</span>
		</button>
	</form>
	{{/* "Watch menu" 7368:416644: a sheet at the bottom of the screen, its title and close
	     button above the choices, the one in force checked. (Its "Receive Dashboard
	     Updates (feed)" is left out: the feed comes from following the subject.) */}}
	<dialog class="article-watch-menu" data-role="article-watch-menu" aria-labelledby="article-watch-menu-title">
		<div class="article-watch-menu-body">
			<div class="article-watch-menu-header">
				<h2 class="article-watch-menu-title" id="article-watch-menu-title">{{ctx.Locale.Tr "repo.watch"}}</h2>
				<button type="button" class="article-watch-menu-close" data-global-click="onArticleWatchMenuClose" aria-label="{{ctx.Locale.Tr "repo.article_watch_menu_close"}}">
					{{svg "octicon-x" 24}}
				</button>
			</div>
			{{/* two actions, the one in force pressed */}}
			<div class="article-watch-menu-options">
				<form hx-boost="true" hx-target="closest .article-watch-control" hx-swap="outerHTML" method="post" action="{{$watchLink}}">
					<button type="submit" class="article-watch-menu-option" aria-pressed="{{if $.IsWatchingRepo}}true{{else}}false{{end}}" data-role="article-watch-notifications">
						<span class="article-watch-menu-check">{{if $.IsWatchingRepo}}{{svg "octicon-check" 16}}{{end}}</span>
						<span>{{ctx.Locale.Tr "repo.article_watch_receive_notifications"}}</span>
					</button>
				</form>
				<form hx-boost="true" hx-target="closest .article-watch-control" hx-swap="outerHTML" method="post" action="{{$unwatchLink}}">
					<button type="submit" class="article-watch-menu-option" aria-pressed="{{if $.IsWatchingRepo}}false{{else}}true{{end}}" data-role="article-watch-ignore">
						<span class="article-watch-menu-check">{{if not $.IsWatchingRepo}}{{svg "octicon-check" 16}}{{end}}</span>
						<span>{{ctx.Locale.Tr "repo.article_watch_ignore"}}</span>
					</button>
				</form>
			</div>
		</div>
	</dialog>
</div>
{{else}}
<a class="forkana-btn forkana-btn-tertiary article-action-button" data-role="article-watch" href="{{$.ArticleSignInLink}}" data-tooltip-content="{{ctx.Locale.Tr "repo.article_watch_guest_user"}}">
	{{svg "octicon-eye" 16}}
	<span>{{ctx.Locale.Tr "repo.watch"}}</span>
</a>
{{end}}
