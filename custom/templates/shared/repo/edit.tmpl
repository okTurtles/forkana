{{define "shared/repo/edit"}}
{{if and .IsArticleModeEdit (not .Repository.IsArchived)}}
<div class="ui bottom attached article-mode-body">
    {{template "shared/repo/article_path" .}}
    {{if .NotEditableReason}}
        <div class="ui warning message">
            <h4>{{.NotEditableReason}}</h4>
            <p>{{ctx.Locale.Tr "repo.editor.file_not_editable_hint"}}</p>
        </div>
    {{else if .BlockedByOwnArticle}}
        {{/* User already owns a different repository for this subject - show message instead of editor.
             SubjectRelation should always be loaded here (via LoadSubject in ArticleView),
             but we fall back to Repository.Name as a defensive measure. */}}
        {{$subjectName := Iif .Repository.SubjectRelation .Repository.SubjectRelation.Name .Repository.Name}}
        <div class="ui info message">
            <div class="header">
                {{svg "octicon-info" 16 "tw-mr-2"}}
                {{ctx.Locale.Tr "repo.editor.already_have_article"}}
            </div>
            <p class="tw-mt-2">
                {{ctx.Locale.Tr "repo.editor.cannot_edit_own_subject" $subjectName}}
            </p>
            <p>
                {{ctx.Locale.Tr "repo.editor.your_article"}} <a href="{{.OwnRepoForSubject.Link}}" class="tw-font-semibold">{{.OwnRepoForSubject.OwnerName}} / {{$subjectName}}</a>
            </p>
            <p class="tw-text-sm tw-text-gray-600 tw-mt-2">
                {{ctx.Locale.Tr "repo.editor.one_article_per_subject"}}
            </p>
        </div>
    {{else}}
        {{/* #434 item 5: the Summary block (figma Textarea 641:65697, I6961:75226): an Inter 600 14/20
             label, 4px above a white box with a 1px #d1d9e0 border, 6px radius and 8px 16px
             padding around Inter 400 16/24 #59636e text. It shows the article's description;
             it is not part of what the editor submits (the article file), so it is read-only. */}}
        <div class="article-summary-field" data-role="article-summary">
            <div class="article-summary-label">{{ctx.Locale.Tr "repo.article_summary"}}</div>
            <div class="article-summary-box">{{or .Repository.Description (ctx.Locale.Tr "repo.article_summary_empty")}}</div>
            {{/* FormControl.Caption I6961:75226;30948:151243: Inter 400 12/18 #59636e, 4px under the box */}}
            <div class="article-summary-caption">{{ctx.Locale.Tr "repo.article_summary_caption" 200}}</div>
        </div>
        {{/* Editor form */}}
        <form class="ui edit form" id="article-edit-form" method="post" action="{{.RepoOperationsLink}}/_edit/{{PathEscapeSegments .BranchName}}/{{.ReadmeTreePath}}"
              data-can-edit-directly="{{if .CanEditDirectly}}true{{else}}false{{end}}"
              data-has-existing-fork="{{if .HasExistingFork}}true{{else}}false{{end}}"
              data-needs-fork="{{if .NeedsFork}}true{{else}}false{{end}}">
            {{.CsrfTokenHtml}}
            <input type="hidden" name="redirect_to_article" value="true">
            <input type="hidden" name="last_commit" value="{{.LastCommitID}}">
            <input type="hidden" name="tree_path" value="{{.ReadmeTreePath}}">
            {{/* Required commit choice field - default to direct commit */}}
            <input type="hidden" name="commit_choice" value="direct">
            {{/* Optional commit message fields - will use default if empty */}}
            <input type="hidden" name="commit_summary" value="">
            <input type="hidden" name="commit_message" value="">
            {{/* Fork-on-edit field - only true when user needs to create a new fork (not when they have an existing fork, as that case shows a link instead of a form) */}}
            <input type="hidden" id="fork_and_edit" name="fork_and_edit" value="{{if .NeedsFork}}true{{else}}false{{end}}">
            {{/* Submit change request field - when true, creates fork + branch + commit + PR back to original */}}
            <input type="hidden" id="submit_change_request" name="submit_change_request" value="false">
            {{/* Change request title and description - optional custom values for the PR */}}
            <input type="hidden" id="change_request_title" name="change_request_title" value="">
            <input type="hidden" id="change_request_description" name="change_request_description" value="">

             {{/* #434 items 10-12: the editor sits in one bordered box (figma "Markdown
                  comment" 641:65701: 1px #d1d9e0, 6px radius) with the writing area framed
                  inside it (Form/Textarea 641:65705) and the contribution tip at its
                  foot (Tip 641:65771). Its toolbar is styled in toast-editor.css. */}}
             <div class="field article-editor-box">
                 <div class="tw-p-0">
                     {{template "shared/citation_editor" .}}
                     <textarea id="edit_area" name="content" class="tw-hidden" data-id="repo-{{.Repository.Name}}-{{.ReadmeTreePath}}" data-raw-file-url="{{.RepoOperationsLink}}/raw/branch/{{PathEscapeSegments .BranchName}}/{{PathEscapeSegments .ReadmeTreePath}}" {{if .IsAttachmentEnabled}}data-attachment-upload-url="{{.RepoLink}}/editor-attachments"{{end}}>{{.FileContent}}</textarea>
                     <div class="editor-loading is-loading"></div>
                     <div id="toast-editor-container" style="min-height: 500px;"></div>
                 </div>
                 <div class="article-editor-tip" data-role="article-contribution-tip">
                     {{svg "octicon-info" 16}}
                     {{/* the contributing guidelines and the code of conduct are the Community
                          notes and Terms pages of the footer: pages to be added later (Pierre,
                          review finding 17 of #457) */}}
                     <span>{{ctx.Locale.Tr "repo.article_contribution_tip" (print AppSubUrl "/community-notes") (print AppSubUrl "/terms")}}</span>
                 </div>
             </div>
        </form>

        {{/* Submit Change Request Modal */}}
        <div class="ui small modal" id="submit-change-request-modal">
            <div class="header">
                {{svg "octicon-git-pull-request" 16 "tw-mr-2"}}
                {{ctx.Locale.Tr "repo.editor.submit_changes_modal_title"}}
            </div>
            <div class="content">
                <div class="ui form">
                    <div class="field">
                        <label for="modal-cr-title">{{ctx.Locale.Tr "repo.editor.change_request_title_label"}}</label>
                        <input type="text" id="modal-cr-title" name="modal-cr-title" placeholder="{{ctx.Locale.Tr "repo.editor.change_request_title_placeholder"}}" maxlength="255">
                    </div>
                    <div class="field">
                        <label for="modal-cr-description">{{ctx.Locale.Tr "repo.editor.change_request_description_label"}}</label>
                        <textarea id="modal-cr-description" name="modal-cr-description" rows="4" placeholder="{{ctx.Locale.Tr "repo.editor.change_request_description_placeholder"}}"></textarea>
                    </div>
                </div>
            </div>
            <div class="actions">
                <button class="ui cancel button">
                    {{svg "octicon-x" 16 "tw-mr-1"}}
                    {{ctx.Locale.Tr "cancel"}}
                </button>
                <button class="ui primary ok button" id="modal-submit-cr-button">
                    {{svg "octicon-git-pull-request" 16 "tw-mr-1"}}
                    {{ctx.Locale.Tr "repo.editor.submit_change_request"}}
                </button>
            </div>
        </div>
    {{end}}
</div>
{{end}}
{{end}}
