{{define "shared/repo/table"}}
{{/* The Table view, figma "Table view / Articles" (641:61176) and, in compare mode, "Table
     view / Comparing articles" (641:61039). Sizes and colours are in
     web_src/css/features/subject-views.css; paging, the expanded rows and compare mode in
     web_src/js/features/repo-history-table.ts. */}}
{{$subjectPath := printf "%s/subject/%s" AppSubUrl (PathEscape .SubjectName)}}
<div class="history-view-section history-view-section--table" data-view="table" {{if not .IsTableView}}hidden{{end}}>
    <div class="history-table">
        <div class="history-table-heading">
            <h2 class="history-table-title">Articles</h2>
            <div class="ui floating dropdown history-table-sort-button">
                <span class="history-table-sort-icon">{{svg "octicon-arrow-switch" 16}}</span>
                <span class="text">Sort</span>
                {{svg "octicon-triangle-down" 16 "history-table-sort-caret"}}
                <div class="menu history-table-sort-menu">
                    {{template "shared/repo/table_sort_item" (dict "Sort" "most_contrib" "Label" "Most contributors" "Current" .HistoryTableSort "SubjectPath" $subjectPath "Selected" .SubjectSelected)}}
                    {{template "shared/repo/table_sort_item" (dict "Sort" "least_contrib" "Label" "Least contributors" "Current" .HistoryTableSort "SubjectPath" $subjectPath "Selected" .SubjectSelected)}}
                    {{template "shared/repo/table_sort_item" (dict "Sort" "latest" "Label" "Latest edited" "Current" .HistoryTableSort "SubjectPath" $subjectPath "Selected" .SubjectSelected)}}
                </div>
            </div>
        </div>

        <div class="history-table-box">
            <table class="history-table-grid" id="articles-table">
                <colgroup>
                    <col class="history-table-col-check">
                    <col class="history-table-col-count">
                    <col class="history-table-col-date">
                    <col class="history-table-col-owner">
                    <col class="history-table-col-toggle">
                </colgroup>
                <thead>
                    <tr>
                        <th><span class="tw-sr-only">{{ctx.Locale.Tr "repo.history_table_compare_column"}}</span></th>
                        <th>Contributors</th>
                        <th>Last edited</th>
                        <th>Owner</th>
                        <th><span class="tw-sr-only">{{ctx.Locale.Tr "repo.history_table_summary_column"}}</span></th>
                    </tr>
                </thead>
                <tbody>
                    {{if .HistoryForkEntries}}
                    {{range $idx, $entry := .HistoryForkEntries}}
                    {{$repo := $entry.Repo}}
                    {{$repoLink := $repo.LinkCtx ctx}}
                    <tr class="article-row" data-row="{{$idx}}" data-owner="{{$repo.OwnerName}}" data-subject="{{$repo.GetSubject ctx}}" data-repo="{{$repo.Name}}" data-archived="{{if $repo.IsArchived}}true{{end}}" data-article-link="{{$repoLink}}" {{if $repo.IsTombstone}}data-tombstone="true"{{end}}>
                        <td class="history-table-check">
                            <input type="checkbox" class="row-check" aria-label="{{ctx.Locale.Tr "repo.history_table_compare_article" (printf "%s/%s" $repo.OwnerName $repo.Name)}}" {{if $repo.IsTombstone}}disabled{{end}}>
                        </td>
                        <td class="history-table-count">{{template "shared/repo/contributor_count" (dict "Count" $entry.ContributorCount "Short" true)}}</td>
                        {{/* figma's date format, "03 Feb 2025" (641:61205): drawn on the server, then again in
                             the reader's time zone (and month names) by repo-history-table.ts */}}
                        <td>{{if $entry.Updated}}<time data-unix="{{$entry.Updated}}" datetime="{{$entry.Updated.FormatDate}}">{{$entry.Updated.Format "02 Jan 2006"}}</time>{{else}}-{{end}}</td>
                        <td class="history-table-owner">
                            {{$repo.OwnerName}}
                            {{if $repo.IsTombstone}}<span class="ui basic label">{{ctx.Locale.Tr "repo.tombstone.label"}}</span>{{end}}
                        </td>
                        <td class="history-table-toggle-cell">
                            <button type="button" class="row-toggle" data-target="desc-{{$idx}}" aria-expanded="false" aria-controls="desc-{{$idx}}" aria-label="{{ctx.Locale.Tr "repo.history_table_show_summary" (printf "%s/%s" $repo.OwnerName $repo.Name)}}">
                                <span class="icon-down">{{svg "octicon-chevron-down"}}</span>
                                <span class="icon-up tw-hidden">{{svg "octicon-chevron-up"}}</span>
                            </button>
                        </td>
                    </tr>
                    <tr id="desc-{{$idx}}" class="article-detail-row tw-hidden">
                        <td colspan="5">
                            <div class="history-table-detail">
                                {{/* The article's summary: its repository description, or else the
                                     first paragraph of its README, fetched when the row is opened,
                                     as the Bubble view does (an empty article and a deleted one have
                                     none). */}}
                                <p class="history-table-summary" data-role="summary"
                                    {{if not (or $entry.Description $repo.IsEmpty $repo.IsTombstone)}}data-summary-src="{{AppSubUrl}}/{{PathEscape $repo.OwnerName}}/{{PathEscape $repo.Name}}/raw/branch/{{PathEscapeSegments $repo.DefaultBranch}}/README.md"{{end}}
                                    data-empty="{{ctx.Locale.Tr "repo_no_desc"}}">{{$entry.Description}}</p>
                                <button type="button" class="forkana-btn forkana-btn-secondary go-to-article" data-owner="{{$repo.OwnerName}}" data-subject="{{$repo.GetSubject ctx}}" data-repo="{{$repo.Name}}" data-archived="{{if $repo.IsArchived}}true{{end}}" data-article-link="{{$repoLink}}">
                                    {{ctx.Locale.Tr "repo.history_table_go_to_article"}}
                                </button>
                            </div>
                        </td>
                    </tr>
                    {{end}}
                    {{else if .SubjectForkGraphFailed}}
                    {{/* the fork graph failed to build (a timeout, say): there may well be articles */}}
                    <tr data-role="history-table-error">
                        <td colspan="5" class="tw-text-center tw-text-sm">
                            <span class="tw-text-red">{{ctx.Locale.Tr "repo.subject_articles_failed"}}</span>
                            {{/* an empty href reloads the page as it is: same view, sort and selection */}}
                            <a class="tw-ml-2" href="">{{ctx.Locale.Tr "repo.subject_articles_retry"}}</a>
                        </td>
                    </tr>
                    {{else}}
                    <tr>
                        <td colspan="5" class="tw-text-center tw-text-sm tw-text-gray-500">No forks available.</td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
            {{if .HistoryForkEntries}}
            {{/* DataTable/Footer (641:61303): "8 of 12", then Previous / Next. Figma's page
                 numbers are collapsed out of the design, so there are none here. */}}
            <div class="history-table-footer" data-role="table-footer">
                <span class="history-table-counter" data-role="table-counter" data-msg-counter="{{ctx.Locale.Tr "repo.history_table_counter"}}"></span>
                <nav class="history-table-pagination" aria-label="{{ctx.Locale.Tr "repo.history_table_pages"}}">
                    <button type="button" class="history-table-page-direction" data-role="table-prev">
                        {{svg "octicon-chevron-left" 16}}<span>{{ctx.Locale.Tr "repo.issues.previous"}}</span>
                    </button>
                    <button type="button" class="history-table-page-direction" data-role="table-next">
                        <span>{{ctx.Locale.Tr "repo.issues.next"}}</span>{{svg "octicon-chevron-right" 16}}
                    </button>
                </nav>
            </div>
            {{end}}
        </div>
        <div class="tw-sr-only" role="status" aria-live="polite" aria-atomic="true" data-role="table-status" data-msg-page="{{ctx.Locale.Tr "repo.history_table_page_status"}}"></div>
    </div>
</div>
{{end}}

{{/* One item of the Sort menu (ActionList.Item/SingleSelect, 641:61313): the current
     order carries figma's check mark in a 16px slot every item keeps. */}}
{{define "shared/repo/table_sort_item"}}
{{$current := eq .Sort .Current}}
<a class="item history-table-sort{{if $current}} is-current{{end}}" data-sort="{{.Sort}}" {{if $current}}aria-current="true"{{end}}
    href="{{QueryBuild .SubjectPath "view" "table" "sort" .Sort "selected" .Selected}}">
    <span class="history-table-sort-check">{{if $current}}{{svg "octicon-check" 16}}{{end}}</span>{{.Label}}
</a>
{{end}}
