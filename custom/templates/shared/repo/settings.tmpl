{{define "shared/repo/settings"}}
{{/* The article settings (#477, figma section "08 · Settings and Collaborators flow"
     7570:71939): opened from the "…" menu, in the 640px column of the article view. The
     owner gets every section, a delegate only the collaborators one. Values are in
     web_src/css/features/article-settings.css, with the figma node each comes from. */}}
{{if .CanManageArticleCollaborators}}
{{$subjectName := .Repository.GetSubject ctx}}
{{$section := .ArticleSettingsSection}}
{{$articleName := printf "%s / %s" .Repository.OwnerName $subjectName}}
<div class="article-settings{{if not .IsRepoOwner}} article-settings-delegate{{end}}" id="article-settings-root" data-section="{{$section}}">
    {{/* "Settings title" 7621:69346: "‹ Back" (the Change requests page's link) to the Read
         tab, then the title. */}}
    <div class="article-settings-title">
        <a class="article-settings-back" href="{{QueryBuild .ArticleLink "view" "article" "mode" "read"}}" data-article-tab="read">
            {{svg "octicon-chevron-left" 16}}<span>{{ctx.Locale.Tr "repo.settings.article_back"}}</span>
        </a>
        {{if .IsRepoOwner}}
            <h2 class="article-settings-heading">{{ctx.Locale.Tr "repo.settings"}}</h2>
        {{else}}
            {{/* A delegate only has the Collaborators section, which the page is named
                 after ("NEW · Delegate – Collaborators" 8020:64472). On a phone, the
                 section's own heading row goes, and its Invite button sits on the title's
                 row instead ("Title row" of 8020:64781). */}}
            <div class="article-settings-title-row">
                <h2 class="article-settings-heading">{{ctx.Locale.Tr "repo.article_more_collaborators"}}</h2>
                {{if and (not .Repository.IsArchived) .ArticleCollaborators}}
                    <button type="button" class="forkana-btn forkana-btn-primary forkana-btn-sm article-settings-title-invite" data-article-settings-modal="#article-collaborator-invite-modal">
                        {{svg "octicon-person-add" 16}}<span>{{ctx.Locale.Tr "repo.settings.article_collaborators_invite_button_short"}}</span>
                    </button>
                {{end}}
            </div>
        {{end}}
    </div>
    {{if .IsRepoOwner}}
        {{/* SegmentedControl 7581:68630 in place of the old left menu */}}
        <div class="forkana-segmented" role="group" aria-label="{{ctx.Locale.Tr "repo.settings.article_sections"}}">
            <button type="button" class="forkana-segmented-item{{if eq $section "general"}} active{{end}}" data-article-settings-section="general" aria-pressed="{{if eq $section "general"}}true{{else}}false{{end}}">{{ctx.Locale.Tr "repo.settings.article_general"}}</button>
            <button type="button" class="forkana-segmented-item{{if eq $section "collaborators"}} active{{end}}" data-article-settings-section="collaborators" aria-pressed="{{if eq $section "collaborators"}}true{{else}}false{{end}}">{{ctx.Locale.Tr "repo.settings.article_collaborators"}}</button>
        </div>

        <div class="article-settings-panel{{if ne $section "general"}} tw-hidden{{end}}" data-article-settings-panel="general">
            {{/* "Box / General" 7581:68929: today's fields, in the read-only input style */}}
            <section class="forkana-box" id="article-settings-general">
                <h3 class="forkana-box-header">{{ctx.Locale.Tr "repo.settings.article_general"}}</h3>
                <div class="forkana-box-body">
                    <div class="forkana-field">
                        <label class="forkana-field-label" for="article-settings-owner">{{ctx.Locale.Tr "repo.settings.collaboration.owner"}}</label>
                        <input class="forkana-input" id="article-settings-owner" type="text" readonly value="{{.Repository.Owner.Name}}">
                    </div>
                    <div class="forkana-field">
                        <label class="forkana-field-label" for="article-settings-source">{{ctx.Locale.Tr "repo.settings.article_source"}}</label>
                        <input class="forkana-input" id="article-settings-source" type="text" readonly value="{{if and .Repository.IsFork .Repository.BaseRepo}}{{.Repository.BaseRepo.OwnerName}} / {{$subjectName}}{{else}}-{{end}}">
                    </div>
                    <div class="forkana-field">
                        <label class="forkana-field-label" for="article-settings-subject">{{ctx.Locale.Tr "repo.settings.article_subject_name"}}</label>
                        <input class="forkana-input" id="article-settings-subject" type="text" readonly value="{{$subjectName}}">
                    </div>
                </div>
            </section>
            {{if not .Repository.IsArchived}}
                {{/* "Box / Transfer ownership" 7581:68966; while a transfer waits for the new
                     owner, "Cancel transfer" (7626:71342) */}}
                <section class="forkana-box" id="article-settings-transfer">
                    <h3 class="forkana-box-header">{{ctx.Locale.Tr "repo.settings.article_transfer"}}</h3>
                    <div class="forkana-box-body article-settings-action">
                        {{if .ArticleTransferRecipient}}
                            <p>{{ctx.Locale.Tr "repo.settings.article_transfer_pending" (printf "@%s" .ArticleTransferRecipient.Name)}}</p>
                            <form action="{{.RepoOperationsLink}}/settings" method="post">
                                {{.CsrfTokenHtml}}
                                <input type="hidden" name="action" value="cancel_transfer">
                                <input type="hidden" name="redirect_to_article" value="true">
                                <button type="submit" id="article-transfer-cancel" class="forkana-btn forkana-btn-secondary forkana-btn-danger-text">{{ctx.Locale.Tr "repo.settings.article_transfer_cancel"}}</button>
                            </form>
                        {{else}}
                            <p>{{ctx.Locale.Tr "repo.settings.article_transfer_desc"}}</p>
                            <button type="button" class="forkana-btn forkana-btn-secondary forkana-btn-danger-text" data-article-settings-modal="#article-transfer-modal">{{ctx.Locale.Tr "repo.settings.article_transfer_button"}}</button>
                        {{end}}
                    </div>
                </section>
                {{/* "Box / Archive" 7581:68977 (an archived article keeps only General and
                     Delete, 7626:72428) */}}
                <section class="forkana-box" id="article-settings-archive">
                    <h3 class="forkana-box-header">{{ctx.Locale.Tr "repo.settings.article_archive"}}</h3>
                    <div class="forkana-box-body article-settings-action">
                        <p>{{ctx.Locale.Tr "repo.settings.article_archive_desc"}}</p>
                        <button type="button" class="forkana-btn forkana-btn-secondary forkana-btn-danger-text" data-article-settings-modal="#article-archive-modal">{{ctx.Locale.Tr "repo.settings.article_archive_button"}}</button>
                    </div>
                </section>
            {{end}}
            {{/* "Box / Delete" 7581:68988 */}}
            <section class="forkana-box" id="article-settings-delete">
                <h3 class="forkana-box-header">{{ctx.Locale.Tr "repo.settings.article_delete"}}</h3>
                <div class="forkana-box-body article-settings-action">
                    <p>{{ctx.Locale.Tr "repo.settings.article_delete_desc"}}</p>
                    <button type="button" class="forkana-btn forkana-btn-secondary forkana-btn-danger-text" data-article-settings-modal="#article-delete-modal">{{ctx.Locale.Tr "repo.settings.article_delete_button"}}</button>
                </div>
            </section>
        </div>
    {{end}}
    <div class="article-settings-panel{{if ne $section "collaborators"}} tw-hidden{{end}}" data-article-settings-panel="collaborators">
        {{template "shared/repo/settings_collaborators" .}}
    </div>
</div>

{{/* the remove dialog is needed on an archived article too, the template leaves out the invite one */}}
{{template "shared/repo/settings_collaborators_modals" .}}

{{if .IsRepoOwner}}
{{if not .Repository.IsArchived}}
{{/* "477 · Transfer – dialog" 7626:70961 and "– pick new owner" 7626:71053 */}}
<div class="ui modal forkana-dialog" id="article-transfer-modal" role="dialog" aria-modal="true" aria-labelledby="article-transfer-modal-title" aria-describedby="article-transfer-desc">
    {{template "shared/repo/settings_dialog_header" (dict "ID" "article-transfer-modal" "Title" (ctx.Locale.Tr "repo.settings.article_transfer_modal_header"))}}
    <form class="forkana-dialog-form" action="{{.RepoOperationsLink}}/settings" method="post">
        {{/* Chrome ignores autocomplete="off" for name-like fields; the invisible dummy
        inputs in "base/disable_form_autofill" absorb the browser's autofill so the
        new-owner value is always picked through the backend-validated search dropdown. */}}
        {{template "base/disable_form_autofill"}}
        {{.CsrfTokenHtml}}
        {{template "shared/repo/settings_dialog_banner" (dict "Kind" "warning" "Message" (ctx.Locale.Tr "repo.settings.article_transfer_notice"))}}
        <div class="content">
            {{template "shared/repo/settings_confirm_field" (dict
                "Action" "transfer"
                "ID" "article-transfer"
                "Prompt" (ctx.Locale.Tr "repo.settings.article_transfer_modal_confirm_desc" (HTMLFormat "<strong>%s</strong>" $articleName))
                "Label" (ctx.Locale.Tr "repo.settings.article_transfer_confirm_label")
                "Value" $articleName)}}
            <div class="forkana-field">
                <label for="article-transfer-new-owner" class="forkana-field-label">{{ctx.Locale.Tr "repo.settings.article_transfer_recipient"}}</label>
                {{template "shared/repo/settings_user_search" (dict
                    "ID" "article-transfer-owner-search"
                    "InputID" "article-transfer-new-owner"
                    "InputName" "new_owner_name"
                    "SearchURL" (printf "%s/settings/transfer_candidates" .RepoLink)
                    "Placeholder" (ctx.Locale.Tr "repo.settings.article_transfer_recipient_placeholder")
                    "Clear" (ctx.Locale.Tr "repo.settings.article_transfer_recipient_clear"))}}
            </div>
        </div>
        {{template "shared/repo/settings_dialog_footer" (dict "ID" "article-transfer-submit" "Type" "submit" "Label" (ctx.Locale.Tr "repo.settings.article_transfer_confirm") "Disabled" true "RequiresOwner" true)}}
    </form>
</div>

{{/* "477 · Archive – dialog" 7626:71162 */}}
<div class="ui modal forkana-dialog" id="article-archive-modal" role="dialog" aria-modal="true" aria-labelledby="article-archive-modal-title" aria-describedby="article-archive-desc">
    {{template "shared/repo/settings_dialog_header" (dict "ID" "article-archive-modal" "Title" (ctx.Locale.Tr "repo.settings.article_archive_modal_header"))}}
    <form class="forkana-dialog-form" action="{{.RepoOperationsLink}}/settings" method="post">
        {{template "base/disable_form_autofill"}}
        {{.CsrfTokenHtml}}
        {{template "shared/repo/settings_dialog_banner" (dict "Kind" "warning" "Message" (ctx.Locale.Tr "repo.settings.article_archive_notice"))}}
        <div class="content">
            {{template "shared/repo/settings_confirm_field" (dict
                "Action" "archive"
                "ID" "article-archive"
                "Prompt" (ctx.Locale.Tr "repo.settings.article_archive_modal_desc" (HTMLFormat "<strong>%s</strong>" $articleName))
                "Label" (ctx.Locale.Tr "repo.settings.article_archive_confirm_label")
                "Value" $articleName)}}
        </div>
        {{template "shared/repo/settings_dialog_footer" (dict "ID" "article-archive-submit" "Type" "submit" "Label" (ctx.Locale.Tr "repo.settings.article_archive_confirm") "Disabled" true)}}
    </form>
</div>
{{end}}

{{/* "477 · Delete – dialog" 7626:71252 */}}
<div class="ui modal forkana-dialog" id="article-delete-modal" role="dialog" aria-modal="true" aria-labelledby="article-delete-modal-title" aria-describedby="article-delete-desc">
    {{template "shared/repo/settings_dialog_header" (dict "ID" "article-delete-modal" "Title" (ctx.Locale.Tr "repo.settings.article_delete_modal_header"))}}
    <form class="forkana-dialog-form" action="{{.RepoOperationsLink}}/settings" method="post">
        {{template "base/disable_form_autofill"}}
        {{.CsrfTokenHtml}}
        {{if .RepoWillBeTombstoned}}
            {{template "shared/repo/settings_dialog_banner" (dict "Kind" "warning" "Message" (ctx.Locale.Tr "repo.settings.article_delete_notice_tombstone"))}}
        {{else}}
            {{template "shared/repo/settings_dialog_banner" (dict "Kind" "warning" "Message" (ctx.Locale.Tr "repo.settings.article_delete_notice" $articleName))}}
        {{end}}
        <div class="content">
            {{template "shared/repo/settings_confirm_field" (dict
                "Action" "delete"
                "ID" "article-delete"
                "Prompt" (ctx.Locale.Tr "repo.settings.article_delete_modal_desc" (HTMLFormat "<strong>%s</strong>" $articleName))
                "Label" (ctx.Locale.Tr "repo.settings.article_delete_confirm_label")
                "Value" $articleName)}}
        </div>
        {{template "shared/repo/settings_dialog_footer" (dict "ID" "article-delete-submit" "Type" "submit" "Label" (ctx.Locale.Tr "repo.settings.article_delete_confirm") "Disabled" true)}}
    </form>
</div>
{{end}}
{{end}}
{{end}}

{{define "shared/repo/settings_confirm_field"}}
{{/* The confirmation of the Transfer, Archive and Delete dialogs (Body of 7626:70961): the
     settings action it posts, the prompt naming the article, and the field to type it in,
     which enables the dialog's button ("<ID>-submit") once it names the article. */}}
<input type="hidden" name="action" value="{{.Action}}">
<input type="hidden" name="redirect_to_article" value="true">
<p id="{{.ID}}-desc">{{.Prompt}}</p>
<div class="forkana-field">
    <label for="{{.ID}}-confirm-name" class="forkana-field-label">{{.Label}}</label>
    <input id="{{.ID}}-confirm-name" class="forkana-input" name="article_name" required maxlength="255"
        autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false"
        data-article-confirm-value="{{.Value}}"
        data-article-confirm-target="#{{.ID}}-submit">
</div>
{{end}}

{{define "shared/repo/settings_dialog_footer"}}
{{/* The footer of the confirmation dialogs (Footer of 7619:68568): Cancel, then the
     action, a secondary button with the red label. */}}
<div class="actions">
    <button type="button" class="cancel forkana-btn forkana-btn-secondary">{{ctx.Locale.Tr "settings.cancel"}}</button>
    <button type="{{.Type}}" id="{{.ID}}" class="forkana-btn forkana-btn-secondary forkana-btn-danger-text forkana-dialog-action"{{if .Disabled}} disabled{{end}}{{if .RequiresOwner}} data-requires-owner-selection="true"{{end}}>{{.Label}}</button>
</div>
{{end}}

{{define "shared/repo/settings_dialog_header"}}
{{/* The dialogs' header (Header of "Remove – states" 7675:74699, as the moderator dialogs):
     grey, the title on the left, an optional 20px person-add icon before it (Invite), and
     the close button on the right. */}}
<div class="header forkana-dialog-header">
    {{if .Icon}}{{svg .Icon 20 "forkana-dialog-icon"}}{{end}}
    <h3 class="forkana-dialog-title" id="{{.ID}}-title" data-role="dialog-title">{{.Title}}</h3>
    <button type="button" class="forkana-dialog-close" data-dialog-close aria-label="{{ctx.Locale.Tr "repo.settings.article_dialog_close"}}">{{svg "octicon-x" 16}}</button>
</div>
{{end}}

{{define "shared/repo/settings_dialog_banner"}}
{{/* A Banner under the dialog's header (Banner I7626:70961 of the Transfer dialog: warning,
     #fff8c5 with a #d4a72c 40% rule under it; the error one of "Remove – states"). */}}
<div class="forkana-dialog-banner forkana-dialog-banner-{{.Kind}}{{if .Hidden}} tw-hidden{{end}}" role="{{if eq .Kind "danger"}}alert{{else}}note{{end}}"{{if .Role}} data-role="{{.Role}}"{{end}}>
    {{if eq .Kind "danger"}}{{svg "octicon-stop" 16}}{{else}}{{svg "octicon-alert" 16}}{{end}}
    <span data-role="dialog-banner-text">{{.Message}}</span>
</div>
{{end}}

{{define "shared/repo/settings_user_search"}}
{{/* A user field searched by username or name (Invite and Transfer, 7619:68300 and
     7626:71053): the results list under the field, then the picked person as a chip with
     their avatar, name, @username and a clear button (7619:68440). */}}
<div id="{{.ID}}" class="ui fluid search article-user-search" data-search-url="{{.SearchURL}}">
    <div class="ui fluid input forkana-input-search">
        {{svg "octicon-search" 16 "forkana-input-icon"}}
        <input id="{{.InputID}}" class="prompt forkana-input" name="{{.InputName}}" required maxlength="255"
            autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false"
            placeholder="{{.Placeholder}}">
    </div>
    <div class="article-user-search-selection tw-hidden">
        <img class="article-user-search-avatar" width="20" height="20" src="" alt aria-hidden="true">
        <span class="article-user-search-name"></span>
        <span class="article-user-search-login"></span>
        <button type="button" class="article-user-search-clear forkana-dialog-close"
            data-tooltip-content="{{.Clear}}" aria-label="{{.Clear}}">{{svg "octicon-x" 16}}</button>
    </div>
</div>
{{end}}
