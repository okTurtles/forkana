{{/* The article's Summary (#475): the repository's description, required and up to 200
     characters (forms.MaxArticleSummaryLength), edited on the article's Edit tab and when its
     first version is written (figma Textarea 7368:264938 in "Article view / Logged out - Edit"
     7368:264887, and 7368:273784 in "New Subject" 7368:273660).
     dict "Value" (the current summary) "Form" (optional: the id of the form it is submitted with,
     for a field outside that form)

     An Inter 600 14/20 label (FormControl.Label: "(required)" is spelled out, never "*"), 4px
     above a 64px white box with a 1px #d1d9e0 border, 6px radius and 8px 16px padding around
     Inter 400 16/24 #59636e text, 4px above the Inter 400 12/18 #59636e caption. Sizes in
     web_src/css/features/article-view.css. The data-* messages are the ones article-summary.ts
     shows when the field is blank or too long. */}}
<div class="article-summary-field" data-role="article-summary">
    <label class="article-summary-label" for="article-summary-input">{{ctx.Locale.Tr "repo.article_summary"}} <span class="article-summary-required">{{ctx.Locale.Tr "repo.article_summary_required_marker"}}</span></label>
    <textarea id="article-summary-input" class="article-summary-box" name="summary" rows="2" required maxlength="200"
        {{if .Form}}form="{{.Form}}"{{end}}
        placeholder="{{ctx.Locale.Tr "repo.article_summary_placeholder"}}"
        aria-describedby="article-summary-caption"
        data-required-message="{{ctx.Locale.Tr "repo.editor.summary_required"}}">{{.Value}}</textarea>
    <div class="article-summary-caption" id="article-summary-caption">{{ctx.Locale.Tr "repo.article_summary_caption" 200}}</div>
</div>
