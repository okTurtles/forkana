{{define "shared/repo/bubble"}}
<div class="history-view-section history-view-section--bubble" data-view="bubble" {{if not .IsBubbleView}}hidden{{end}}>
    <div id="bubble-view-root"
        class="history-bubble-root"
        data-owner="{{.Repository.Owner.Name}}"
        data-repo="{{.Repository.Name}}"
        data-subject="{{.SubjectName}}"
        data-default-branch="{{.Repository.DefaultBranch}}"
        {{/* the same parameters the page's embedded graph is built with (repo_service.SubjectForkGraphQuery) */}}
        data-api-url="{{AppSubUrl}}/api/v1/repos/{{.Repository.Owner.Name}}/{{.Repository.Name}}/forks/graph?{{.SubjectForkGraphQuery}}">
    </div>
</div>
{{end}}
