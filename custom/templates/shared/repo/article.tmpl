{{define "shared/repo/article"}}
<div class="history-view-section history-view-section--article" data-view="article" {{if not .IsArticleView}}hidden{{end}}>
    <div class="ui" id="article-view-root" data-article-mode="{{if .ArticleMode}}{{.ArticleMode}}{{else}}read{{end}}">
        {{/* the one "nothing selected" message, shared with the placeholder section */}}
        {{template "shared/repo/article_empty_message" (dict "Hidden" .ReadmeRequested)}}
        {{/* Outside the article content, on every branch (a tombstone and a README error
             too): repo-history.ts shows them while another article is fetched into this
             section, or when that fails. */}}
        <div class="ui active inline loader tw-mt-4" data-role="article-loader" hidden></div>
        <div class="ui error message tw-mt-4" data-role="article-error" hidden>
            <p data-role="article-error-text"></p>
        </div>
        <div data-role="article-content" {{if not .ReadmeRequested}}hidden{{end}}>
        {{/* #433 item 9, #434 item 7, #435 item 5: no "Back to bubble view" link here; the
             Bubble view tab is right above. */}}
        {{if .IsTombstonedRepo}}
            {{template "shared/repo/tombstone_notice" dict "Repository" .Repository}}
        {{else if .ReadmeError}}
            <div class="ui error message">
                {{.ReadmeError}}
            </div>
        {{else}}
            {{/* #433 item 2: the two tokens of figma Frame 549 (641:65477): "335 Contributors"
                 with person-24 and "Last updated: Yesterday" with sync-24, 14px apart. The
                 number 641:65477 draws before "Last updated" is left out, at Pierre's request
                 (the later frames, 6961:73971, have none either). */}}
            <div class="article-tokens" data-role="article-tokens">
                <span class="article-token">
                    {{svg "octicon-person" 16}}
                    <span>{{template "shared/repo/contributor_count" (dict "Count" .ReadmeContributorCount "Label" "title")}}</span>
                </span>
                {{if and .ReadmeLastCommit .ReadmeLastCommit.Committer}}
                    <span class="article-token" data-role="article-last-updated">
                        {{svg "octicon-sync" 16}}
                        <span>{{ctx.Locale.Tr "repo.article_last_updated" (DateUtils.TimeSince .ReadmeLastCommit.Committer.When)}}</span>
                    </span>
                {{end}}
            </div>
            {{/* ArticleLink points at the route the article was requested through, so the
                 tabs keep the reader on the vanity URL or the permanent repository URL.
                 Every handler that renders this view sets it (prepareArticleView falls back
                 to the repository link), so there is no fallback to build here: a local one
                 could only hard-code the vanity URL, which resolves to a different article
                 for an archived repository. */}}
            {{$articleLink := .ArticleLink}}
            <div id="article-tabs">
                <div class="ui top attached tabular menu">
                    <a class="{{if .IsArticleModeRead}}active {{end}}item"
                        href="{{QueryBuild $articleLink "view" "article" "mode" "read"}}"
                        data-article-tab="read">
                        {{svg "octicon-book" 16}} Read
                    </a>
                    {{if not .Repository.IsArchived}}
                        <a class="{{if .IsArticleModeEdit}}active {{end}}item"
                            href="{{QueryBuild $articleLink "view" "article" "mode" "edit"}}"
                            data-article-tab="edit">
                            {{svg "octicon-pencil" 16}} Edit
                        </a>
                    {{end}}
                    <a class="{{if .IsArticleModeHistory}}active {{end}}item"
                        href="{{QueryBuild $articleLink "view" "article" "mode" "history"}}"
                        data-article-tab="history">
                        {{svg "octicon-history" 16}} History
                    </a>
                    {{if .CanManageArticleCollaborators}}
                        <a class="{{if .IsArticleModeSettings}}active {{end}}item"
                            href="{{QueryBuild $articleLink "view" "article" "mode" "settings"}}"
                            data-article-tab="settings">
                            {{svg "octicon-gear" 16}} {{ctx.Locale.Tr "repo.settings"}}
                        </a>
                    {{end}}
                </div>
                <div class="article-tabs-trailing">
                    {{/* #408: no "..." menu in the Read and History modes. It held a
                         "Something" placeholder; the only items the figma gives it (Watch and
                         Report, node 662:98305) are the Watch button below and a report flow
                         that does not exist yet. */}}
                    {{/* #433 item 3: Watch at the end of the tabs' row (figma View Tab
                         641:65480, Action I7368:264703;24375:95729), in every tab. The subject
                         header's Follow star, which toggles the same watch, stays above it
                         (#469: the header is the same on every view). The hidden input is the article's id,
                         which the star sends so that its answer can update this button. */}}
                    {{if .RepoOperationsLink}}
                        <div class="article-watch">
                            {{if .IsSigned}}<input type="hidden" id="article-watch-sync" name="sync_button_repo" value="{{.Repository.ID}}">{{end}}
                            <div id="article-watch-slot">{{template "repo/watch_button" .}}</div>
                        </div>
                    {{end}}
                    {{if and .IsArticleModeEdit (not .Repository.IsArchived)}}
                        {{/* Fork and Submit changes at the end of the row, 9px apart (Frame 9
                             7368:264912 of "Article view / Logged out - Edit" 7368:264887).
                             Submit changes is the design system's medium primary button
                             (Button 7368:264915: 32px, 6/12 padding, Inter 600 14/20, no icon),
                             in its unavailable colours when it cannot be used. */}}
                        <div class="tw-flex tw-items-center">
                            <div class="article-edit-actions">
                                {{if .IsSigned}}
                                    {{if .CanEditDirectly}}
                                        {{/* The owner and the maintainers edit directly - show simple submit button */}}
                                        <button type="button" id="submit-changes-button" class="forkana-btn forkana-btn-primary" data-fork-and-edit="false">
                                            {{ctx.Locale.Tr "repo.editor.submit_changes"}}
                                        </button>
                                    {{else if .BlockedByOwnArticle}}
                                        {{/* User owns an independent article for this subject (not a fork of this repo) */}}
                                        {{/* They cannot submit change requests here - redirect to their own article */}}
                                        <a href="{{.OwnRepoForSubject.Link}}?view=article&mode=edit" class="forkana-btn forkana-btn-primary">
                                            {{svg "octicon-pencil" 16}}
                                            {{ctx.Locale.Tr "repo.editor.edit_your_article"}}
                                        </a>
                                    {{else if .HasExistingFork}}
                                        {{/* User has an existing fork of this repo - show both options */}}
                                        {{if .ExistingForkArchived}}
                                            {{/* An archived fork is read-only, so editing it is refused: only a change request is possible */}}
                                            <span class="forkana-btn forkana-btn-unavailable disabled" data-tooltip-content="{{ctx.Locale.Tr "repo.editor.existing_fork_archived"}}">
                                                {{ctx.Locale.Tr "repo.editor.edit_in_your_fork"}}
                                            </span>
                                        {{else}}
                                            <a href="{{.ExistingFork.Link}}?view=article&mode=edit" class="forkana-btn forkana-btn-secondary">
                                                {{ctx.Locale.Tr "repo.editor.edit_in_your_fork"}}
                                            </a>
                                        {{end}}
                                        {{if .CanSubmitChangeRequest}}
                                        <button type="button" id="pre-submit-changes-button" class="forkana-btn forkana-btn-primary"
                                            data-tooltip-content="{{ctx.Locale.Tr "repo.editor.submit_changes_tooltip"}}">
                                            {{ctx.Locale.Tr "repo.editor.submit_changes"}}
                                        </button>
                                        {{end}}
                                    {{else if .NeedsFork}}
                                        {{/* User needs to create a fork - show fork-and-submit button */}}
                                        <button type="button" id="fork-article-button" class="forkana-btn forkana-btn-secondary"
                                            data-fork-and-edit="true"
                                            data-tooltip-content="{{ctx.Locale.Tr "repo.fork_article_confirm_body"}}"
                                            data-fork-confirm-title="{{ctx.Locale.Tr "repo.fork_article_confirm_title"}}"
                                            data-fork-confirm-body="{{ctx.Locale.Tr "repo.fork_article_confirm_body"}}"
                                            data-fork-confirm-body2="{{ctx.Locale.Tr "repo.fork_article_confirm_body2"}}"
                                            data-fork-confirm-yes="{{ctx.Locale.Tr "repo.fork_article_confirm_yes"}}"
                                            data-fork-confirm-cancel="{{ctx.Locale.Tr "repo.fork_article_confirm_cancel"}}">
                                            {{/* Button 7368:264913: the label and the article's fork count, no icon */}}
                                            <span>{{ctx.Locale.Tr "repo.fork_article"}}</span>
                                            <span class="article-fork-count" data-role="article-fork-count"
                                                aria-label="{{ctx.Locale.TrN .Repository.NumForks "repo.article_forks_1" "repo.article_forks_n" .Repository.NumForks}}">{{.Repository.NumForks}}</span>
                                        </button>
                                        {{/* Submit Change Request - opens modal for title/description, then creates branch + commit + PR */}}
                                        {{if .CanSubmitChangeRequest}}
                                        <button type="button" id="pre-submit-changes-button" class="forkana-btn forkana-btn-primary"
                                            data-tooltip-content="{{ctx.Locale.Tr "repo.editor.submit_changes_tooltip"}}">
                                            {{ctx.Locale.Tr "repo.editor.submit_changes"}}
                                        </button>
                                        {{end}}
                                    {{else}}
                                        {{/* Fallback - show disabled button with generic tooltip.
                                             This block is a safety net that should rarely be reached.
                                             It handles unexpected permission states where the user is signed in
                                             but none of the specific conditions (owner, blocked, has fork, needs fork) apply. */}}
                                        <span data-tooltip-content="{{ctx.Locale.Tr "repo.editor.editing_unavailable"}}">
                                            <button type="button" class="forkana-btn forkana-btn-primary-unavailable disabled" disabled aria-label="{{ctx.Locale.Tr "repo.editor.submit_changes"}} - {{ctx.Locale.Tr "repo.editor.editing_unavailable"}}">
                                                {{ctx.Locale.Tr "repo.editor.submit_changes"}}
                                            </button>
                                        </span>
                                    {{end}}
                                {{else}}
                                    {{/* #434 items 8 and 9: a signed-out reader sees Fork, with the
                                         article's fork count, and Submit changes, both in their
                                         unavailable colours (Button 7368:264913: 84×32, #f6f8fa, a
                                         #818b98 10% border, an Inter 600 14/20 #818b98 label and its
                                         count in a CounterLabel; Button 7368:264915). Both need an
                                         account, so both lead to sign in. */}}
                                    {{$signIn := .ArticleSignInLink}}
                                    <a class="forkana-btn forkana-btn-unavailable" id="signed-out-fork-button" href="{{$signIn}}"
                                        data-tooltip-content="{{ctx.Locale.Tr "repo.article_fork_guest_user"}}">
                                        <span>{{ctx.Locale.Tr "repo.fork_article"}}</span>
                                        <span class="article-fork-count" data-role="article-fork-count"
                                            aria-label="{{ctx.Locale.TrN .Repository.NumForks "repo.article_forks_1" "repo.article_forks_n" .Repository.NumForks}}">{{.Repository.NumForks}}</span>
                                    </a>
                                    <a class="forkana-btn forkana-btn-primary-unavailable" id="signed-out-submit-button" href="{{$signIn}}"
                                        data-tooltip-content="{{ctx.Locale.Tr "repo.editor.sign_in_to_edit_tooltip"}}">
                                        {{ctx.Locale.Tr "repo.editor.submit_changes"}}
                                    </a>
                                {{end}}
                            </div>
                        </div>
                    {{end}}
                </div>
            </div>
            {{template "shared/repo/read" .}}
            {{template "shared/repo/edit" .}}
            {{template "shared/repo/history" .}}
            {{template "shared/repo/settings" .}}
        {{end}}
        </div>
    </div>
</div>
{{end}}
