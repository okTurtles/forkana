{{define "shared/repo/read"}}
{{if .IsArticleModeRead}}
<div class="ui bottom attached article-mode-body">
    {{template "shared/repo/article_path" .}}
    {{/* #433 item 7: the article's summary, Inter 400 16/24 #59636e (figma Text
         641:65505), 24px under the path. It is the article's description, which the
         bubble view shows too; an article without one shows none here (the bubble view
         falls back to its first paragraph, which here is right below anyway).
         The "James99 and 3 others you know marked this article as correct" line that
         used to be here was a hard-coded placeholder, absent from the figma (item 5). */}}
    {{if .Repository.Description}}
        <p class="article-summary" data-role="article-summary">{{.Repository.Description}}</p>
    {{end}}
    {{if .IsFileTooLarge}}
        <div class="ui error message">
            {{ctx.Locale.Tr "repo.file_too_large"}}
        </div>
    {{else}}
        <div class="file-view article-content {{if .IsMarkup}}markup {{.MarkupType}}{{else if .IsPlainText}}plain-text{{end}}">
            {{if .IsMarkup}}
                {{.FileContent}}
            {{else if .IsPlainText}}
                <pre>{{if .FileContent}}{{.FileContent}}{{end}}</pre>
            {{end}}
        </div>
    {{end}}
</div>
{{end}}
{{end}}
