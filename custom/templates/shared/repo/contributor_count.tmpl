{{/* An article's contributor count, as every view of the subject shows it: "-" when the
     count is unknown (-1, or missing), else the number (through CountFmt when .Short),
     followed by "contributor(s)" when .Label is "lower" or "Contributor(s)" when it is
     "title". */}}
{{define "shared/repo/contributor_count"}}
{{- $n := .Count -}}
{{- $num := "-" -}}
{{- if not (and $n (lt $n 0))}}{{if .Short}}{{$num = CountFmt (or $n 0)}}{{else}}{{$num = printf "%d" (or $n 0)}}{{end}}{{end -}}
{{- if not .Label}}{{$num}}
{{- else if eq .Label "title"}}{{ctx.Locale.TrN (or $n 0) "repo.contributor_count_title_1" "repo.contributor_count_title_n" $num}}
{{- else}}{{ctx.Locale.TrN (or $n 0) "repo.contributor_count_lower_1" "repo.contributor_count_lower_n" $num}}{{end -}}
{{end}}
