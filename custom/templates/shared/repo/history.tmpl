{{define "shared/repo/history"}}
{{if .IsArticleModeHistory}}
{{/* #435: the History tab's table follows figma DataTable 641:64085 ("Article view /
     History" 641:64052): a 1px #d1d9e0 frame with 6px corners, a 32px #f6f8fa header of
     Inter 600 12/20 #59636e labels, 36px rows with a 24px avatar with 6px corners (not a
     circle), the message's expand chevron at the right of its cell, and a footer with
     "N of M" and the pager (DataTable/Footer 641:64224). The last column says where each
     change came from: a commit icon for one made in this article, the fork icon for one
     contributed through a fork. The Sort menu switches it to the article's forks. */}}
<div class="ui bottom attached article-mode-body">
    {{template "shared/repo/article_path" .}}
    {{if eq .HistorySort "forks"}}
        {{$forks := .ArticleForks}}
        {{if .ArticleForksError}}
            <div class="ui error message" data-role="article-history-forks-error">{{ctx.Locale.Tr "repo.article_history_forks_error"}}</div>
        {{else if not .HistoryTotal}}
            <div class="ui message" data-role="article-history-no-forks">{{ctx.Locale.Tr "repo.article_history_no_forks"}}</div>
        {{else}}
        <div class="article-history-table" data-role="article-history" data-sort="forks">
            <table id="forks-table">
                <thead>
                    <tr>
                        <th class="col-user">{{ctx.Locale.Tr "repo.commits.user"}}</th>
                        <th class="col-code">{{ctx.Locale.Tr "repo.commits.code"}}</th>
                        <th class="col-message">{{ctx.Locale.Tr "repo.commits.message"}}</th>
                        <th class="col-date">{{ctx.Locale.Tr "repo.commits.date"}}</th>
                        <th class="col-icon"></th>
                    </tr>
                </thead>
                <tbody>
                    {{range $forks}}
                    <tr>
                        <td class="col-user">
                            <div class="article-history-user">
                                {{if .Repo.Owner}}
                                    {{ctx.AvatarUtils.Avatar .Repo.Owner 24 "article-history-avatar"}}
                                    <a class="author-wrapper" href="{{.Repo.Owner.HomeLink}}">{{.Repo.Owner.Name}}</a>
                                {{else}}
                                    <span class="author-wrapper">{{.Repo.OwnerName}}</span>
                                {{end}}
                            </div>
                        </td>
                        <td class="col-code sha">
                            {{if .HeadCommitID}}<a href="{{.Repo.LinkCtx ctx}}" rel="nofollow">{{ShortSha .HeadCommitID}}</a>{{end}}
                        </td>
                        <td class="col-message">
                            <a class="article-history-message" href="{{.Repo.LinkCtx ctx}}">{{or .Repo.Description (print .Repo.OwnerName " / " (.Repo.GetSubject ctx))}}</a>
                        </td>
                        <td class="col-date">{{DateUtils.TimeSince .Repo.UpdatedUnix}}</td>
                        <td class="col-icon">
                            <span data-tooltip-content="{{ctx.Locale.Tr "repo.article_history_fork"}}">{{svg "octicon-repo-forked" 16}}</span>
                        </td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
            {{template "shared/repo/article_history_footer" .}}
        </div>
        {{end}}
    {{else if .CommitCount}}
        <div class="article-history-table" data-role="article-history" data-sort="changes">
            <table id="commits-table">
                <thead>
                    <tr>
                        <th class="col-user">{{ctx.Locale.Tr "repo.commits.user"}}</th>
                        <th class="col-code sha">{{ctx.Locale.Tr "repo.commits.code"}}</th>
                        <th class="col-message message">{{ctx.Locale.Tr "repo.commits.message"}}</th>
                        <th class="col-date">{{ctx.Locale.Tr "repo.commits.date"}}</th>
                        <th class="col-icon"></th>
                    </tr>
                </thead>
                <tbody class="commit-list">
                    {{range .Commits}}
                    {{$fromFork := index $.CommitsFromOtherArticles .ID.String}}
                    <tr>
                        <td class="col-user author">
                            <div class="article-history-user">
                                {{$userName := .Author.Name}}
                                {{if .User}}
                                    {{if and .User.FullName DefaultShowFullName}}
                                        {{$userName = .User.FullName}}
                                    {{end}}
                                    {{ctx.AvatarUtils.Avatar .User 24 "article-history-avatar"}}
                                    <a class="author-wrapper" href="{{.User.HomeLink}}">{{$userName}}</a>
                                {{else}}
                                    {{ctx.AvatarUtils.AvatarByEmail .Author.Email .Author.Name 24 "article-history-avatar"}}
                                    <span class="author-wrapper">{{$userName}}</span>
                                {{end}}
                            </div>
                        </td>
                        <td class="col-code sha">
                            <a href="{{QueryBuild $.ArticleLink "version" .ID.String}}" rel="nofollow">
                                {{ShortSha .ID.String}}
                            </a>
                        </td>
                        <td class="col-message message">
                            {{/* #435 item 12: the row expands, from the chevron at the right of
                                 the message (figma chevron-up-24 641:64110), to the full commit
                                 message and id. A <details> needs no script, which matters here:
                                 this section is also fetched and swapped in by repo-history.ts. */}}
                            <details class="article-history-details">
                                <summary aria-label="{{ctx.Locale.Tr "repo.article_history_expand"}}">
                                    <span class="commit-summary" title="{{.Summary}}">{{.Summary | ctx.RenderUtils.RenderEmoji}}</span>
                                    {{svg "octicon-chevron-down" 16 "article-history-chevron"}}
                                </summary>
                                <div class="article-history-body">
                                    {{$body := ctx.RenderUtils.RenderCommitBody .Message $.Repository}}
                                    {{if $body}}<pre class="commit-body">{{$body}}</pre>{{end}}
                                    <code class="article-history-sha">{{.ID.String}}</code>
                                </div>
                            </details>
                        </td>
                        <td class="col-date">{{DateUtils.TimeSince (or .Committer .Author).When}}</td>
                        <td class="col-icon">
                            <a href="{{QueryBuild $.ArticleLink "version" .ID.String}}" data-tooltip-content="{{if $fromFork}}{{ctx.Locale.Tr "repo.article_history_from_fork"}}{{else}}{{ctx.Locale.Tr "repo.article_history_commit"}}{{end}}" aria-label="{{ctx.Locale.Tr "repo.commits.view_path"}}">
                                {{if $fromFork}}{{svg "octicon-repo-forked" 16}}{{else}}{{svg "octicon-git-commit" 16}}{{end}}
                            </a>
                        </td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
            {{template "shared/repo/article_history_footer" .}}
        </div>
    {{else}}
        <div class="ui message">
            {{ctx.Locale.Tr "repo.article_history_no_changes"}}
        </div>
    {{end}}
</div>
{{end}}
{{end}}

{{/* The table's footer (DataTable/Footer 641:64224): the rows shown, as Primer's DataTable
     counts them ("51-100 of 335"), or that a page past the last one is empty, and the
     pager, so that such a page has a way back. */}}
{{define "shared/repo/article_history_footer"}}
<div class="article-history-footer">
    <span class="article-history-count">
        {{- if .HistoryFirst}}{{ctx.Locale.Tr "repo.article_history_range" .HistoryFirst .HistoryLast .HistoryTotal}}{{else}}{{ctx.Locale.Tr "repo.article_history_page_empty"}}{{end -}}
    </span>
    {{if .Page}}{{template "shared/repo/article_history_pager" .}}{{end}}
</div>
{{end}}

{{/* The footer's pager (figma Pagination 641:64228): Previous and Next as Inter 400
     14/20 #4e40fa links with their chevrons, the pages as 32×32 boxes with 6px corners,
     the current one filled #4e40fa. The links keep the page's other parameters. */}}
{{define "shared/repo/article_history_pager"}}
{{$params := .Page.GetParams}}
{{$link := .Link}}
{{with .Page.Paginater}}
<nav class="article-history-pager" aria-label="{{ctx.Locale.Tr "repo.commits.commits"}}">
    <a class="article-history-page-direction{{if not .HasPrevious}} disabled{{end}}" {{if .HasPrevious}}href="{{$link}}?page={{.Previous}}{{if $params}}&{{$params}}{{end}}"{{else}}aria-disabled="true"{{end}}>
        {{svg "octicon-chevron-left" 16}}<span>{{ctx.Locale.Tr "repo.issues.previous"}}</span>
    </a>
    {{range .Pages}}
        {{if eq .Num -1}}
            <span class="article-history-page">…</span>
        {{else if .IsCurrent}}
            <span class="article-history-page active" aria-current="page">{{.Num}}</span>
        {{else}}
            <a class="article-history-page" href="{{$link}}?page={{.Num}}{{if $params}}&{{$params}}{{end}}">{{.Num}}</a>
        {{end}}
    {{end}}
    <a class="article-history-page-direction{{if not .HasNext}} disabled{{end}}" {{if .HasNext}}href="{{$link}}?page={{.Next}}{{if $params}}&{{$params}}{{end}}"{{else}}aria-disabled="true"{{end}}>
        <span>{{ctx.Locale.Tr "repo.issues.next"}}</span>{{svg "octicon-chevron-right" 16}}
    </a>
</nav>
{{end}}
{{end}}
