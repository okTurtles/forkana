{{define "shared/repo/settings_collaborators"}}
{{/* The collaborators section of the article settings, shown to the owner and to the
     delegates (#461; figma "Collaborators – list" 7618:67561, "– empty" 7618:68143, "– 1
     selected" 7618:67929 and their mobile frames 7622:69172, 7640:74117). An archived
     article takes no new collaborators, the existing ones can still have their role
     changed or be removed. The role values are repo_model.ArticleCollaboratorRole: 1 is
     Maintainer, 2 is Maintainer delegate. */}}
{{$perm := .ArticleCollaboratorPerm}}
{{$canInvite := not .Repository.IsArchived}}
{{$owner := .Repository.Owner}}
{{$doerIsOwner := .IsRepoOwner}}
<section class="forkana-box article-collaborators" id="article-settings-collaborators">
    <div class="forkana-box-header article-collaborators-header">
        <h3>{{ctx.Locale.Tr "repo.settings.article_collaborators"}}</h3>
        {{if and $canInvite .ArticleCollaborators}}
            {{/* (the short label on a phone, "Collaborators header" 7622:69251) */}}
            <button type="button" class="forkana-btn forkana-btn-primary forkana-btn-sm" data-article-settings-modal="#article-collaborator-invite-modal">
                {{svg "octicon-person-add" 16}}
                <span class="article-collaborators-invite-long">{{ctx.Locale.Tr "repo.settings.article_collaborators_invite_button"}}</span>
                <span class="article-collaborators-invite-short">{{ctx.Locale.Tr "repo.settings.article_collaborators_invite_button_short"}}</span>
            </button>
        {{end}}
    </div>
    <div class="forkana-box-body">
    {{if .ArticleCollaborators}}
        {{$you := ctx.Locale.Tr "repo.settings.article_collaborators_summary_you"}}
        {{if not $doerIsOwner}}{{$you = $owner.DisplayName}}{{end}}
        {{$accepted := ctx.Locale.TrN .ArticleCollaboratorsAccepted "repo.settings.article_collaborators_count_1" "repo.settings.article_collaborators_count_n" .ArticleCollaboratorsAccepted}}
        {{$pending := ctx.Locale.TrN .ArticleCollaboratorsPending "repo.settings.article_collaborators_waiting_1" "repo.settings.article_collaborators_waiting_n" .ArticleCollaboratorsPending}}
        <p class="article-collaborators-summary" data-role="collaborators-summary">
            {{- if and .ArticleCollaboratorsAccepted .ArticleCollaboratorsPending -}}
                {{ctx.Locale.Tr "repo.settings.article_collaborators_summary_three" .ArticleCollaboratorsPeople $you $accepted $pending}}
            {{- else if .ArticleCollaboratorsAccepted -}}
                {{ctx.Locale.Tr "repo.settings.article_collaborators_summary_two" .ArticleCollaboratorsPeople $you $accepted}}
            {{- else -}}
                {{ctx.Locale.Tr "repo.settings.article_collaborators_summary_two" .ArticleCollaboratorsPeople $you $pending}}
            {{- end -}}
        </p>
        <form id="article-collaborators-remove-form" class="article-collaborators-table" method="post" action="{{.RepoOperationsLink}}/article_collaborators/remove">
            {{.CsrfTokenHtml}}
            {{/* "Header row": Select all and the Role filter, or, while someone is
                 selected, "N selected" and "Remove selected" (7618:67929) */}}
            <div class="article-collaborators-toolbar">
                <label class="article-collaborators-select-all">
                    <input type="checkbox" id="article-collaborators-select-all" aria-label="{{ctx.Locale.Tr "repo.settings.article_collaborators_select_all"}}">
                    <span data-role="select-all-label" data-label-all="{{ctx.Locale.TrString "repo.settings.article_collaborators_select_all_label"}}"
                        data-label-selected="{{ctx.Locale.TrString "repo.settings.article_collaborators_selected" "{count}"}}">{{ctx.Locale.Tr "repo.settings.article_collaborators_select_all_label"}}</span>
                </label>
                <div class="ui left dropdown custom article-collaborators-filter" id="article-collaborators-role-filter" tabindex="0"
                    aria-label="{{ctx.Locale.Tr "repo.settings.article_collaborators_filter_role"}}">
                    <span>{{ctx.Locale.Tr "repo.settings.article_collaborators_filter_role"}}</span>
                    {{svg "octicon-triangle-down" 16}}
                    <div class="menu forkana-menu">
                        <div class="item active" data-value="">{{template "shared/repo/settings_menu_check"}}<span>{{ctx.Locale.Tr "repo.settings.article_collaborators_filter_all"}}</span></div>
                        <div class="item" data-value="1">{{template "shared/repo/settings_menu_check"}}<span>{{ctx.Locale.Tr "repo.settings.article_collaborators_role_maintainer"}}</span></div>
                        <div class="item" data-value="2">{{template "shared/repo/settings_menu_check"}}<span>{{ctx.Locale.Tr "repo.settings.article_collaborators_role_delegate"}}</span></div>
                    </div>
                </div>
                {{/* only shown while at least one collaborator is selected */}}
                <button type="button" id="article-collaborators-remove-selected" class="forkana-btn forkana-btn-secondary forkana-btn-sm forkana-btn-danger-text tw-hidden">
                    {{ctx.Locale.Tr "repo.settings.article_collaborators_remove_selected"}}
                </button>
            </div>
            <div class="article-collaborators-search-row">
                <div class="forkana-input-search">
                    {{svg "octicon-search" 16 "forkana-input-icon"}}
                    <input type="search" class="forkana-input forkana-input-sm" id="article-collaborators-search" autocomplete="off"
                        placeholder="{{ctx.Locale.Tr "repo.settings.article_collaborators_search_placeholder"}}"
                        aria-label="{{ctx.Locale.Tr "repo.settings.article_collaborators_search_placeholder"}}">
                </div>
            </div>
            <ul class="article-collaborators-list">
                {{/* the owner first: no checkbox, no actions (Row / JaneZ (you)) */}}
                <li class="article-collaborator-row is-owner" data-article-collaborator-owner>
                    <div class="article-collaborator-who">
                        <span class="article-collaborator-select"></span>
                        <a class="article-collaborator-person" href="{{$owner.HomeLink}}">
                            {{ctx.AvatarUtils.Avatar $owner 20}}
                            <span>{{if $doerIsOwner}}{{ctx.Locale.Tr "repo.settings.article_collaborators_you" $owner.DisplayName}}{{else}}{{$owner.DisplayName}}{{end}}</span>
                        </a>
                    </div>
                    <div class="article-collaborator-details">
                        <div class="article-collaborator-role-cell"><span class="forkana-label">{{ctx.Locale.Tr "repo.settings.article_collaborators_owner"}}</span></div>
                        <div class="article-collaborator-status"></div>
                        <div class="article-collaborator-action"></div>
                    </div>
                </li>
                {{range .ArticleCollaborators}}
                    {{$canRemove := $perm.CanRemove .}}
                    <li class="article-collaborator-row" data-article-collaborator data-role="{{.Role}}" data-search="{{.User.LowerName}} {{.User.FullName}}"
                        data-name="{{.User.DisplayName}}" data-pending="{{if .IsPending}}true{{end}}">
                        <div class="article-collaborator-who">
                            <span class="article-collaborator-select">
                                {{if $canRemove}}
                                    <input type="checkbox" name="uid" value="{{.UserID}}" data-article-collaborator-select
                                        aria-label="{{ctx.Locale.Tr "repo.settings.article_collaborators_select" .User.DisplayName}}">
                                {{end}}
                            </span>
                            {{/* the full name, falling back to the username */}}
                            <a class="article-collaborator-person" href="{{.User.HomeLink}}">
                                {{ctx.AvatarUtils.Avatar .User 20}}
                                <span>{{if eq .UserID $.SignedUserID}}{{ctx.Locale.Tr "repo.settings.article_collaborators_you" .User.DisplayName}}{{else}}{{.User.DisplayName}}{{end}}</span>
                            </a>
                        </div>
                        <div class="article-collaborator-details">
                            <div class="article-collaborator-role-cell">
                                {{if $perm.CanChangeRoles}}
                                    <div class="ui dropdown custom article-collaborator-role" tabindex="0" data-uid="{{.UserID}}" data-last-value="{{.Role}}"
                                        data-url="{{$.RepoOperationsLink}}/article_collaborators/role">
                                        <span class="text">{{ctx.Locale.Tr .Role.LocaleKey}}</span>
                                        {{svg "octicon-triangle-down" 16 "dropdown icon"}}
                                        {{template "shared/repo/settings_collaborators_role_menu" (dict "IsOwner" $perm.IsOwner "Selected" .Role)}}
                                    </div>
                                {{else}}
                                    <span class="article-collaborator-role-text" data-tooltip-content="{{ctx.Locale.Tr "repo.settings.article_collaborators_role_readonly"}}">{{ctx.Locale.Tr .Role.LocaleKey}}</span>
                                {{end}}
                            </div>
                            <div class="article-collaborator-status">
                                {{if .IsPending}}
                                    <span class="forkana-label forkana-label-attention">{{ctx.Locale.Tr "repo.settings.article_collaborators_status_pending"}}</span>
                                {{end}}
                            </div>
                            <div class="article-collaborator-action">
                                {{if $canRemove}}
                                    <button type="button" class="forkana-btn forkana-btn-tertiary forkana-btn-sm" data-article-collaborator-remove="{{.UserID}}"
                                        aria-label="{{ctx.Locale.Tr "repo.settings.article_collaborators_remove_tooltip" .User.DisplayName}}">
                                        {{svg "octicon-trash" 16}}<span>{{ctx.Locale.Tr "repo.settings.article_collaborators_remove"}}</span>
                                    </button>
                                {{end}}
                            </div>
                        </div>
                    </li>
                {{end}}
            </ul>
            <p class="article-collaborators-no-match tw-hidden" id="article-collaborators-no-match">{{ctx.Locale.Tr "repo.settings.article_collaborators_no_match"}}</p>
        </form>
    {{else}}
        {{/* the design system's Blankslate (7618:68143): person-add icon, title, one line
             and the Invite button */}}
        <div class="forkana-blankslate" id="article-collaborators-empty">
            {{svg "octicon-person-add" 32 "forkana-blankslate-icon"}}
            <h4 class="forkana-blankslate-heading">{{ctx.Locale.Tr "repo.settings.article_collaborators_empty"}}</h4>
            <p class="forkana-blankslate-description">{{ctx.Locale.Tr "repo.settings.article_collaborators_empty_desc"}}</p>
            {{if $canInvite}}
                <div class="forkana-blankslate-action">
                    <button type="button" class="forkana-btn forkana-btn-primary" data-article-settings-modal="#article-collaborator-invite-modal">
                        {{svg "octicon-person-add" 16}}<span>{{ctx.Locale.Tr "repo.settings.article_collaborators_invite_button"}}</span>
                    </button>
                </div>
            {{end}}
        </div>
    {{end}}
    </div>
</section>
{{end}}

{{define "shared/repo/settings_menu_check"}}
{{/* the tick of a single-select item (ActionList.Item/SingleSelect 7645:75728) */}}
<span class="forkana-menu-check" aria-hidden="true">{{svg "octicon-check" 16}}</span>
{{end}}

{{define "shared/repo/settings_collaborators_role_menu"}}
{{/* The access levels with their descriptions ("Overlay / Access type" of 7645:75728), the
     delegate level only for the owner: a delegate can never grant delegation. */}}
<div class="menu forkana-menu">
    <div class="item{{if eq (print .Selected) "1"}} active selected{{end}}" data-value="1" data-text="{{ctx.Locale.Tr "repo.settings.article_collaborators_role_maintainer"}}">
        {{template "shared/repo/settings_menu_check"}}
        <span class="forkana-menu-label">
            <span>{{ctx.Locale.Tr "repo.settings.article_collaborators_role_maintainer"}}</span>
            <span class="forkana-menu-description">{{ctx.Locale.Tr "repo.settings.article_collaborators_role_maintainer_desc"}}</span>
        </span>
    </div>
    {{if .IsOwner}}
        <div class="item{{if eq (print .Selected) "2"}} active selected{{end}}" data-value="2" data-text="{{ctx.Locale.Tr "repo.settings.article_collaborators_role_delegate"}}">
            {{template "shared/repo/settings_menu_check"}}
            <span class="forkana-menu-label">
                <span>{{ctx.Locale.Tr "repo.settings.article_collaborators_role_delegate"}}</span>
                <span class="forkana-menu-description">{{ctx.Locale.Tr "repo.settings.article_collaborators_role_delegate_desc"}}</span>
            </span>
        </div>
    {{end}}
</div>
{{end}}

{{define "shared/repo/settings_collaborators_modals"}}
{{$subjectName := .Repository.GetSubject ctx}}
{{/* The invite and remove dialogs, the invite one only while the article takes new collaborators. */}}
{{if not .Repository.IsArchived}}
{{/* "Invite – search" 7619:68300 and "– choose role" 7619:68440; a bottom sheet on a
     phone (7622:69567) */}}
<div class="ui modal forkana-dialog" id="article-collaborator-invite-modal" role="dialog" aria-modal="true" aria-labelledby="article-collaborator-invite-modal-title">
    {{template "shared/repo/settings_dialog_header" (dict "ID" "article-collaborator-invite-modal" "Title" (ctx.Locale.Tr "repo.settings.article_collaborators_invite_modal_header") "Icon" "octicon-person-add")}}
    <form class="forkana-dialog-form" action="{{.RepoOperationsLink}}/article_collaborators/invite" method="post">
        {{/* see the transfer dialog: the dummy inputs absorb the browser's autofill so the
        invitee is always picked through the backend-validated search dropdown */}}
        {{template "base/disable_form_autofill"}}
        {{.CsrfTokenHtml}}
        <div class="content">
            <div class="forkana-field">
                <label for="article-collaborator-invitee" class="forkana-field-label">{{ctx.Locale.Tr "repo.settings.article_collaborators_invitee"}}</label>
                {{template "shared/repo/settings_user_search" (dict
                    "ID" "article-collaborator-invite-search"
                    "InputID" "article-collaborator-invitee"
                    "InputName" "invitee_name"
                    "SearchURL" (printf "%s/settings/collaborator_candidates" .RepoLink)
                    "Placeholder" (ctx.Locale.Tr "repo.settings.article_collaborators_invitee_placeholder")
                    "Clear" (ctx.Locale.Tr "repo.settings.article_collaborators_invitee_clear"))}}
            </div>
            {{/* the access level once someone is picked (7619:68440) */}}
            <div class="forkana-field tw-hidden" data-role="invite-access">
                <span class="forkana-field-label" id="article-collaborator-role-label">{{ctx.Locale.Tr "repo.settings.article_collaborators_access"}}</span>
                {{/* the maintainer role, data-default-value restores it when the dialog is reopened */}}
                {{$defaultRole := "1"}}
                <div class="ui selection dropdown forkana-select" id="article-collaborator-role" data-default-value="{{$defaultRole}}" tabindex="0" aria-labelledby="article-collaborator-role-label">
                    <input type="hidden" name="role" value="{{$defaultRole}}">
                    <span class="text">{{ctx.Locale.Tr "repo.settings.article_collaborators_role_maintainer"}}</span>
                    {{svg "octicon-triangle-down" 16 "dropdown icon"}}
                    {{template "shared/repo/settings_collaborators_role_menu" (dict "IsOwner" .ArticleCollaboratorPerm.IsOwner "Selected" 1)}}
                </div>
                <p class="forkana-field-caption" data-role="invite-hint" data-template="{{ctx.Locale.TrString "repo.settings.article_collaborators_invite_hint" "{name}"}}"></p>
            </div>
        </div>
        <div class="actions">
            <span class="forkana-dialog-footer-hint" data-role="invite-reason">{{ctx.Locale.Tr "repo.settings.article_collaborators_select_user"}}</span>
            <button type="button" class="cancel forkana-btn forkana-btn-secondary">{{ctx.Locale.Tr "settings.cancel"}}</button>
            <button type="submit" id="article-collaborator-invite-submit" class="forkana-btn forkana-btn-primary" disabled
                data-label-select="{{ctx.Locale.TrString "repo.settings.article_collaborators_invite_plain"}}"
                data-label-invite="{{ctx.Locale.TrString "repo.settings.article_collaborators_invite_submit" "{name}"}}">{{ctx.Locale.Tr "repo.settings.article_collaborators_invite_plain"}}</button>
        </div>
    </form>
</div>
{{end}}

{{/* "Remove collaborator – confirm" 7619:68568 and its states ("Remove – states"
     7675:74699): the title and the text name who is removed, a waiting invite is
     cancelled instead; "Removing…" while it is sent, an error banner if it fails. */}}
<div class="ui modal forkana-dialog" id="article-collaborators-remove-modal" role="dialog" aria-modal="true"
    aria-labelledby="article-collaborators-remove-modal-title" aria-describedby="article-collaborators-remove-desc"
    data-title-one="{{ctx.Locale.TrString "repo.settings.article_collaborators_remove_modal_header_1"}}"
    data-title-many="{{ctx.Locale.TrString "repo.settings.article_collaborators_remove_modal_header_n" "{count}"}}"
    data-title-invite="{{ctx.Locale.TrString "repo.settings.article_collaborators_cancel_invite_modal_header" "{name}"}}"
    data-desc-one="{{ctx.Locale.TrString "repo.settings.article_collaborators_remove_modal_desc_one" "{name}" $subjectName}}"
    data-desc-many="{{ctx.Locale.TrString "repo.settings.article_collaborators_remove_modal_desc_many" $subjectName}}"
    data-desc-invite="{{ctx.Locale.TrString "repo.settings.article_collaborators_cancel_invite_modal_desc" "{name}" $subjectName}}"
    data-confirm="{{ctx.Locale.TrString "repo.settings.article_collaborators_remove_confirm"}}"
    data-confirm-invite="{{ctx.Locale.TrString "repo.settings.article_collaborators_cancel_invite_confirm"}}"
    data-removing="{{ctx.Locale.TrString "repo.settings.article_collaborators_removing"}}"
    data-failed-one="{{ctx.Locale.TrString "repo.settings.article_collaborators_remove_failed" "{name}"}}"
    data-failed-many="{{ctx.Locale.TrString "repo.settings.article_collaborators_remove_failed_n" "{count}"}}">
    {{template "shared/repo/settings_dialog_header" (dict "ID" "article-collaborators-remove-modal" "Title" (ctx.Locale.Tr "repo.settings.article_collaborators_remove_modal_header_1"))}}
    {{template "shared/repo/settings_dialog_banner" (dict "Kind" "danger" "Message" "" "Hidden" true "Role" "remove-error")}}
    <div class="content"><p id="article-collaborators-remove-desc" data-role="remove-desc"></p></div>
    {{template "shared/repo/settings_dialog_footer" (dict "ID" "article-collaborators-remove-submit" "Type" "button" "Label" (ctx.Locale.Tr "repo.settings.article_collaborators_remove_confirm"))}}
</div>
{{end}}
