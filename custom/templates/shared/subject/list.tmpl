<div class="flex-list">
	{{if .HasSearchKeyword}}
		{{/* When searching, show exact match and similar results separately */}}
		{{if .Keyword}}
			<h2 class="subject-list-heading" data-role="subject-search-heading">
				{{ctx.Locale.Tr "explore.search_results_for" .Keyword}}
			</h2>
		{{end}}

		{{/* No Exact Match - Show Create Button */}}
		{{if not .ExactMatch}}
			{{if .ExactSubject}}
				{{/* The subject exists but this listing does not show it: link to it instead of
				     inviting the user to create a duplicate. */}}
				<div class="subject-no-exact">
					<p class="subject-no-exact-message">
						{{svg "octicon-filter" 16}} <span>{{ctx.Locale.Tr "search.exact_page_exists_not_shown" .ExactSubject.Name}}</span>
					</p>
					<a class="forkana-btn forkana-btn-secondary forkana-btn-sm" href="{{AppSubUrl}}/subject/{{PathEscape .ExactSubject.Name}}">
						{{ctx.Locale.Tr "search.view_existing_subject"}}
					</a>
				</div>
			{{else}}
				{{/* figma 7368:273128: the message (Frame 1018 7368:273143) and the small secondary
				     "Create a new Subject" button (Button 7368:273149), not a primary one (#248 item 3) */}}
				<div class="subject-no-exact">
					<p class="subject-no-exact-message">
						{{svg "octicon-skip" 16}} <span>{{ctx.Locale.Tr "search.no_exact_page_found" .Keyword}}</span>
					</p>
					{{if .NewSubjectTitle}}
						<a class="forkana-btn forkana-btn-secondary forkana-btn-sm" data-role="create-new-subject" href="{{AppSubUrl}}/repo/create?subject={{QueryEscape .NewSubjectTitle}}">
							{{ctx.Locale.Tr "search.create_new_subject"}}
						</a>
					{{end}}
				</div>
			{{end}}
		{{end}}

		{{/* Exact Match Section */}}
		{{if .ExactMatch}}
			{{template "shared/subject/item" .ExactMatch}}
		{{end}}

		{{/* Similar Section */}}
		{{if .SimilarSubjects}}
			<h2 class="subject-list-heading subject-list-similar">
				{{ctx.Locale.Tr "explore.subject.similar"}}
			</h2>
			{{range .SimilarSubjects}}
				{{template "shared/subject/item" .}}
			{{end}}
		{{end}}

	{{else}}
		{{/* When not searching, show all subjects normally */}}
		{{range .Subjects}}
			{{template "shared/subject/item" .}}
		{{else}}
			<div>
				{{ctx.Locale.Tr "search.no_results"}}
			</div>
		{{end}}
	{{end}}
</div>

