{{/*
	Subject item partial template
	Expects a Subject object with: Name

	A subject row is name-only by design (#248): the leading icon is "octicon-goal" so a row
	matches the Subjects tab in explore/navbar.tmpl, and neither the repository counts that
	Gitea's stock flex-list puts in "flex-item-trailing" nor the created/updated line it puts in
	"flex-item-body" are rendered. That leaves nothing for "flex-item-main"/"flex-item-header" to
	lay out, so the title is a direct child of the row. Row spacing, the icon colour, the
	capitalised first letter and the removal of the flex-list separators live in
	explore-subjects.custom.css.
*/}}
<div class="flex-item">
	<div class="flex-item-leading">
		{{svg "octicon-goal" 16}}
	</div>
	<div class="flex-item-title">
		<a class="text primary name" href="{{AppSubUrl}}/subject/{{PathEscapeSegments .Name}}">{{.Name}}</a>
	</div>
</div>
