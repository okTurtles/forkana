{{/* Overrides templates/explore/user_list.tmpl.

	When a search keyword is present, the results are split into a "Search results
	for ..." section holding the user the keyword actually names and a "Similar"
	section holding everything else, mirroring the subjects tab (#276). The split
	itself is done in routers/web/explore/user.go.

	Each run of user rows gets its own ".flex-list.explore-users-rows" box, which is
	what carries the border. The headings and the no-exact-match note are siblings of
	those boxes, not children, so the border wraps only the rows. "flex-list" has to
	stay on the same element as the rows because the row separator rule is
	".flex-list > .flex-item + .flex-item" -- a direct-child selector.

	Without a keyword ".HasSearchKeyword" is false and the plain unfiltered list below is
	rendered exactly as before. So it is on the pages that share this template without
	being the users tab, which set no search data at all: /explore/organizations (same
	handler AND same template, see routers/web/explore/user.go) and
	templates/admin/user/view.tmpl. An org listing must not answer a search with "No user
	named exactly ...". */}}
{{if .HasSearchKeyword}}
	{{/* ".HasSearchKeyword" is set to "Keyword != \"\"", so the keyword is known non-empty here */}}
	<div class="tw-font-bold tw-text-14 tw-mb-4">
		{{ctx.Locale.Tr "explore.search_results_for" .Keyword}}
	</div>

	{{if or .ExactMatches .SimilarUsers}}
		{{/* The exact matches, or a note that nobody goes by that name exactly -- the
			"Similar" list below is then the whole answer. There can be more than one
			exact match: usernames are unique but full names are not. */}}
		{{if .ExactMatches}}
			<div class="flex-list explore-users-rows">
				{{range .ExactMatches}}
					{{template "shared/user/explore_item" (dict "User" . "Root" $)}}
				{{end}}
			</div>
		{{else}}
			<p class="tw-flex tw-items-center tw-gap-2 tw-italic tw-text-sm text muted tw-mb-3">
				{{svg "octicon-skip" 16}} {{ctx.Locale.Tr "explore.user.no_exact_match" .Keyword}}
			</p>
		{{end}}

		{{/* Similar Section */}}
		{{if .SimilarUsers}}
			<div class="tw-font-semibold tw-text-14 tw-mt-6 tw-mb-3 text muted">
				{{ctx.Locale.Tr "explore.user.similar"}}
			</div>
			<div class="flex-list explore-users-rows">
				{{range .SimilarUsers}}
					{{template "shared/user/explore_item" (dict "User" . "Root" $)}}
				{{end}}
			</div>
		{{end}}
	{{else}}
		<div class="flex-list explore-users-rows">
			<div class="flex-item">
				{{ctx.Locale.Tr "search.no_results"}}
			</div>
		</div>
	{{end}}

{{else}}
	<div class="flex-list explore-users-rows">
		{{range .Users}}
			{{template "shared/user/explore_item" (dict "User" . "Root" $)}}
		{{else}}
			<div class="flex-item">
				{{ctx.Locale.Tr "search.no_results"}}
			</div>
		{{end}}
	</div>
{{end}}
