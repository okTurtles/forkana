{{/* Template for rendering fork hierarchy nodes recursively */}}
{{define "fork_hierarchy_node"}}
    {{$node := .Node}}
    {{$currentRepo := .CurrentRepo}}
    {{$ctx := .ctx}}

    {{if and $node $node.Repository}}

    <div class="item fork-level-{{$node.Level}}">
        <div class="ui grid">
            <div class="two wide column">
                {{if $node.Repository.Owner}}
                    {{ctx.AvatarUtils.Avatar $node.Repository.Owner 32}}
                {{else}}
                    {{svg "octicon-person" 32}}
                {{end}}
            </div>
            <div class="fourteen wide column">
                <div class="content">
                    <div class="header">
                        {{/* Indentation indicators for hierarchy levels */}}
                        {{if gt $node.Level 0}}
                            {{if eq $node.Level 1}}<span class="ui basic mini label">{{svg "octicon-git-branch" 12}}</span>{{end}}
                            {{if eq $node.Level 2}}<span class="ui basic mini label">{{svg "octicon-git-branch" 12}}</span><span class="ui basic mini label">{{svg "octicon-git-branch" 12}}</span>{{end}}
                            {{if gt $node.Level 2}}<span class="ui basic mini label">{{svg "octicon-git-branch" 12}}</span><span class="ui basic mini label">{{svg "octicon-git-branch" 12}}</span><span class="ui basic mini label">{{svg "octicon-git-branch" 12}}</span>{{end}}
                        {{end}}

                        <a class="ui large text" href="/subject/{{$node.Repository.GetSubject ctx}}">
                            <strong>{{if $node.Repository.Owner}}{{$node.Repository.Owner.Name}}{{else}}unknown{{end}}/{{$node.Repository.Name}}</strong>
                        </a>

                        <span class="ui small labels">
                            {{if eq $node.Level 0}}
                                <span class="ui blue label">
                                    {{svg "octicon-repo" 12 "tw-mr-1"}}
                                    {{ctx.Locale.Tr "repo.root"}}
                                </span>
                            {{else}}
                                <span class="ui basic label">
                                    {{svg "octicon-repo-forked" 12 "tw-mr-1"}}
                                    {{ctx.Locale.Tr "repo.fork"}}
                                </span>
                            {{end}}

                            {{if eq $node.Repository.FullName $currentRepo.FullName}}
                                <span class="ui green label">
                                    {{svg "octicon-eye" 12 "tw-mr-1"}}
                                    {{ctx.Locale.Tr "repo.current"}}
                                </span>
                            {{end}}

                            {{if $node.Repository.IsPrivate}}
                                <span class="ui basic label">
                                    {{svg "octicon-lock" 12 "tw-mr-1"}}
                                    {{ctx.Locale.Tr "repo.desc.private"}}
                                </span>
                            {{end}}

                            {{if $node.Repository.IsArchived}}
                                <span class="ui basic label">
                                    {{svg "octicon-archive" 12 "tw-mr-1"}}
                                    {{ctx.Locale.Tr "repo.desc.archived"}}
                                </span>
                            {{end}}
                        </span>
                    </div>

                    {{if $node.Repository.Description}}
                        <div class="description tw-mt-2">
                            {{$node.Repository.Description}}
                        </div>
                    {{end}}

                    <div class="extra tw-mt-3">
                        <div class="ui horizontal list">
                            <div class="item">
                                <i class="clock icon"></i>
                                {{if $node.Repository.UpdatedUnix}}
                                    {{ctx.Locale.Tr "repo.last_updated"}} {{DateUtils.TimeSince $node.Repository.UpdatedUnix}}
                                {{else}}
                                    {{ctx.Locale.Tr "repo.never_updated"}}
                                {{end}}
                            </div>
                            {{$repoLink := $node.Repository.LinkCtx ctx}}
                            <div class="item">
                                <a href="{{$repoLink}}/stars" class="ui basic mini label">
                                    {{svg "octicon-star" 12 "tw-mr-1"}}
                                    {{CountFmt $node.Repository.NumStars}}
                                </a>
                            </div>
                            <div class="item">
                                <a href="{{$repoLink}}/forks" class="ui basic mini label">
                                    {{svg "octicon-repo-forked" 12 "tw-mr-1"}}
                                    {{CountFmt $node.Repository.NumForks}}
                                </a>
                            </div>
                            <div class="item">
                                <a href="{{$repoLink}}/issues" class="ui basic mini label">
                                    {{svg "octicon-issue-opened" 12 "tw-mr-1"}}
                                    {{CountFmt $node.Repository.NumIssues}}
                                </a>
                            </div>
                            {{if $node.Repository.PrimaryLanguage}}
                                <div class="item">
                                    <span class="ui basic mini label">
                                        <i class="circle icon" style="color: {{$node.Repository.PrimaryLanguage.Color}}"></i>
                                        {{$node.Repository.PrimaryLanguage.Language}}
                                    </span>
                                </div>
                            {{end}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{/* Recursively render children */}}
    {{range $node.Children}}
        {{template "fork_hierarchy_node" (dict "Node" . "CurrentRepo" $currentRepo "ctx" $ctx)}}
    {{end}}
    {{end}}
{{end}}

{{template "base/head" .}}
<style>
/* Temporary Fork hierarchy level styling until we agree on design */
.fork-level-0 { margin-left: 0px !important; }
.fork-level-1 { margin-left: 20px !important; }
.fork-level-2 { margin-left: 40px !important; }
.fork-level-3 { margin-left: 60px !important; }
.fork-level-4 { margin-left: 80px !important; }
.fork-level-5 { margin-left: 100px !important; }
/* Articles table spacing */
#articles-table col.checkbox { width: 10px; }
#articles-table col.actions { width: 80px; }
/* The bubble view root (.history-bubble-root) is laid out in
   web_src/css/features/bubble-graph.css: it fills the space between the repo
   header and the footer through the page's flex layout instead of the
   "calc(100vh - 25rem)" magic number that used to live here and pushed the
   footer below the fold (#149). */
</style>
<div role="main" aria-label="{{.Title}}" class="page-content repository file list">
    {{/* The Compare mode banner (figma "Announcement" 641:61937 / 641:61765 / 641:61848 /
         6661:53348) is drawn here, under the navbar and above the subject, by the bubble
         view (FishboneGraph teleports CompareAnnouncement.vue into it). The strings come
         from the locale file. */}}
    <div id="compare-announcement-root"
        data-msg-select="{{ctx.Locale.Tr "repo.compare_mode_select"}}"
        data-msg-one="{{ctx.Locale.Tr "repo.compare_mode_one_selected"}}"
        data-msg-ready="{{ctx.Locale.Tr "repo.compare_mode_ready"}}"
        data-msg-no-forks="{{ctx.Locale.Tr "repo.compare_mode_no_forks"}}"
        data-msg-compare-now="{{ctx.Locale.Tr "repo.compare_mode_compare_now"}}"
        data-msg-dismiss="{{ctx.Locale.Tr "repo.compare_mode_dismiss"}}"
        data-msg-dismiss-notice="{{ctx.Locale.Tr "repo.compare_mode_dismiss_notice"}}"></div>
    {{/* Rendered outside the article section so it stays visible on every article
    mode (read, edit, history, settings); repo-history.ts keeps it in sync when the
    article section is swapped or another view is selected. */}}
    {{/* tw-hidden, not the hidden attribute: tw-flex would otherwise win over the UA [hidden] rule */}}
    <div class="ui warning message tw-mt-0 tw-flex tw-items-start tw-gap-2{{if not (and .Repository.IsArchived .IsArticleView .ArticleChosen)}} tw-hidden{{end}}" id="article-archived-notice">
        {{svg "octicon-alert" 16 "tw-mt-1 tw-flex-shrink-0"}}
        <span data-role="article-archived-text">
            {{- if .Repository.IsArchived -}}
                {{ctx.Locale.Tr "repo.settings.article_archived_notice" (DateUtils.AbsoluteLong (Iif .Repository.ArchivedUnix.IsZero .Repository.UpdatedUnix .Repository.ArchivedUnix))}}
            {{- end -}}
        </span>
    </div>

    {{/* Shown to the pending transfer's recipient so the article can be accepted or
    rejected without visiting the settings of an article they do not own yet. */}}
    {{if and .RepoTransfer .CanUserAcceptOrRejectTransfer}}
    <div class="ui info message tw-mt-0 tw-flex tw-items-center tw-justify-between tw-gap-4" id="article-transfer-notice">
        <div class="tw-flex tw-items-center tw-gap-2">
            {{svg "octicon-info" 16 "tw-flex-shrink-0"}}
            <span>{{ctx.Locale.Tr "repo.settings.article_transfer_recipient_notice"
                (HTMLFormat `<a href="%s">%s</a>` .RepoTransfer.Doer.HomeLink .RepoTransfer.Doer.DisplayName)
                (HTMLFormat `<a href="%s">%s</a>` .RepoLink .SubjectName)}}</span>
        </div>
        <div class="tw-flex tw-items-center tw-gap-2">
            <form class="tw-m-0" method="post" action="{{.RepoOperationsLink}}/action/accept_transfer">
                {{.CsrfTokenHtml}}
                <button type="submit" class="ui primary button tw-m-0 tw-whitespace-nowrap">{{ctx.Locale.Tr "repo.settings.article_transfer_accept"}}</button>
            </form>
            <form class="tw-m-0" method="post" action="{{.RepoOperationsLink}}/action/reject_transfer">
                {{.CsrfTokenHtml}}
                <button type="submit" class="ui button tw-m-0 tw-text-red tw-font-bold tw-whitespace-nowrap">{{ctx.Locale.Tr "repo.settings.article_transfer_reject"}}</button>
            </form>
        </div>
    </div>
    {{end}}

    {{/* Login banner for non-authenticated users */}}
    {{if and .IsArticleModeEdit (not .IsSigned)}}
    <div class="ui warning message tw-mt-0">
        <div class="tw-flex tw-items-center tw-gap-2">
            {{svg "octicon-alert" 16}}
            <span class="tw-color-text">You are not logged in. You have to <a href="{{AppSubUrl}}/user/login?redirect_to={{QueryEscape .Link}}">Sign in</a> / <a href="{{AppSubUrl}}/user/sign_up?redirect_to={{QueryEscape .Link}}">Sign up</a> in order to do edits.</span>
        </div>
    </div>
    {{end}}
    {{template "repo/header" .}}

    <div class="ui container">
        {{ $subjectPath := printf "%s/subject/%s" AppSubUrl (PathEscape .SubjectName) }}
        <div id="repo-history-app"
            class="history-view-app"
            data-initial-view="{{.HistoryView}}"
            data-initial-mode="{{if .ArticleMode}}{{.ArticleMode}}{{else}}read{{end}}"
            {{/* set when the article section holds a rendered article: the one an article url
                 names, the one "selected=" names, or a subject's only article. That article is
                 then the page's selection. */}}
            data-initial-article="{{if and .IsArticleView .ArticleChosen}}true{{end}}"
            data-initial-owner="{{.Repository.Owner.Name}}"
            data-initial-repo="{{.Repository.Name}}"
            data-initial-subject="{{.SubjectName}}"
            data-initial-archived="{{if .Repository.IsArchived}}true{{end}}"
            data-initial-link="{{.Repository.LinkCtx ctx}}"
            data-subject-url="{{$subjectPath}}"
            data-bubble-url="{{QueryBuild $subjectPath "view" "bubble"}}"
            data-table-url="{{QueryBuild $subjectPath "view" "table"}}"
            data-article-base="{{printf "%s/subject" AppSubUrl}}"
            {{if .ArticleLink}}data-article-canonical="{{.ArticleLink}}"{{end}}>
            {{template "shared/repo/bubble" .}}
            {{template "shared/repo/table" .}}
            {{if and .IsArticleView .ArticleChosen}}
                {{template "shared/repo/article" .}}
            {{else}}
                {{/* Not rendered as an article yet: the section is filled in when an article is
                     selected. Until then it has to say so, exactly like a rendered article
                     section does when nothing is selected (#405 item 1); the loading
                     placeholder only shows while an article is being fetched. */}}
                <div class="history-view-section history-view-section--article" data-view="article" {{if not .IsArticleView}}hidden{{end}}>
                    {{template "shared/repo/article_empty_message" (dict "Hidden" false)}}
                    {{/* the loader and error roles of a rendered article section too, so a fetch
                         that fails replaces the skeleton with its error instead of loading forever */}}
                    <div data-role="article-content" hidden>
                        <div class="history-view-placeholder ui segment loading placeholder" data-role="article-loader">
                            <div class="header">
                                <div class="line"></div>
                                <div class="line"></div>
                            </div>
                            <div class="paragraph">
                                <div class="line"></div>
                                <div class="line"></div>
                                <div class="line"></div>
                            </div>
                        </div>
                        <div class="ui error message tw-mt-4" data-role="article-error" hidden>
                            <p data-role="article-error-text"></p>
                        </div>
                    </div>
                </div>
            {{end}}
        </div>
    </div>
</div>
{{template "base/footer" .}}
