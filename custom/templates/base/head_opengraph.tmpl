{{- /* What a link shows when it is shared (Slack, Discord, X, iMessage...), #450: Forkana's
	site name, the page's title and description, and Forkana's share image on every page;
	never Gitea's name, description or logo, nor a repository or owner avatar.
	A subject or an article page gets its title, description, type and url from
	.ShareMeta (services/sharemeta); og:description stays under about 200 characters. */ -}}
{{- $siteName := ShareSiteName -}}
{{- $title := $siteName -}}
{{- $description := ShareSiteDescription -}}
{{- $type := "website" -}}
{{- $url := AbsoluteURL ctx .Link -}}
{{- if .ShareMeta -}}
	{{- $title = .ShareMeta.Title -}}
	{{- $description = .ShareMeta.Description -}}
	{{- $type = .ShareMeta.Type -}}
	{{- $url = .ShareMeta.URL -}}
	{{- if .Issue -}}
		{{- /* a change request of the article */ -}}
		{{- $title = printf "%s · %s" .Issue.Title $siteName -}}
		{{- $url = .Issue.HTMLURL ctx -}}
		{{- with ShareTextSummary .Issue.Content -}}{{- $description = . -}}{{- end -}}
	{{- end -}}
{{- else if .PageIsUserProfile -}}
	{{- $title = printf "%s · %s" .ContextUser.DisplayName $siteName -}}
	{{- $type = "profile" -}}
	{{- $url = .ContextUser.HTMLURL ctx -}}
	{{- with ShareTextSummary .ContextUser.Description -}}{{- $description = . -}}{{- end -}}
{{- else if .Title -}}
	{{- $title = printf "%s · %s" .Title $siteName -}}
{{- end -}}
{{- $image := ShareImage ctx -}}
<meta property="og:site_name" content="{{$siteName}}">
<meta property="og:title" content="{{$title}}">
<meta property="og:description" content="{{$description}}">
<meta property="og:type" content="{{$type}}">
<meta property="og:url" content="{{$url}}">
<meta property="og:image" content="{{$image.URL}}">
<meta property="og:image:width" content="{{$image.Width}}">
<meta property="og:image:height" content="{{$image.Height}}">
<meta property="og:image:alt" content="{{$image.Alt}}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{$title}}">
<meta name="twitter:description" content="{{$description}}">
<meta name="twitter:image" content="{{$image.URL}}">
<meta name="twitter:image:alt" content="{{$image.Alt}}">
