{{/* The Point of contention table, after figma "Bubble view / Point of contention"
	(641:62387, Table 641:62410) on desktop and the Mobile frame 641:64701 (Frame 736,
	641:64723) on phones; the styles are in web_src/css/features/subject-compare.css.

	Desktop: a grey column header with each article's contributor count, a row with the
	article (fork icon, "owner / subject", last update), then the lines side by side.
	Phones: one column; each change shows the first article's header, article row and
	line, then the second's, and an unchanged line once. */}}
{{$Subject := .root.Subject}}
{{$Repo1 := .root.Repo1}}
{{$Repo2 := .root.Repo2}}
{{$SplitViewLines := .root.SplitViewLines}}
{{$Repo1ContributorCount := .root.Repo1ContributorCount}}
{{$Repo2ContributorCount := .root.Repo2ContributorCount}}
{{$side1 := dict "Repo" $Repo1 "Subject" $Subject "Count" $Repo1ContributorCount}}
{{$side2 := dict "Repo" $Repo2 "Subject" $Subject "Count" $Repo2ContributorCount}}
<colgroup class="poc-cols-desktop">
	<col class="poc-col-num">
	<col>
	<col class="poc-col-num">
	<col>
</colgroup>
<colgroup class="poc-cols-mobile">
	<col class="poc-col-num">
	<col>
</colgroup>
<tr class="poc-colhead-row poc-desktop">
	<th colspan="2" class="poc-colhead">{{template "shared/repo/contributor_count" (dict "Count" $Repo1ContributorCount "Label" "title")}}</th>
	<th colspan="2" class="poc-colhead poc-side2">{{template "shared/repo/contributor_count" (dict "Count" $Repo2ContributorCount "Label" "title")}}</th>
</tr>
<tr class="poc-article-row poc-desktop">
	<td colspan="2" class="poc-article">{{template "repo/diff/subject_compare_article" $side1}}</td>
	<td colspan="2" class="poc-article poc-side2">{{template "repo/diff/subject_compare_article" $side2}}</td>
</tr>
{{range $i, $line := $SplitViewLines}}
	{{if eq $line.LeftType 1}}{{/* the same on both sides: shown once on phones */}}
		<tr class="poc-line poc-same" data-line-type="same">
			<td class="poc-num">{{$line.LeftIdx}}</td>
			<td class="poc-code"><span class="poc-text">{{$line.LeftContent}}</span></td>
			<td class="poc-num poc-side2 poc-desktop">{{$line.RightIdx}}</td>
			<td class="poc-code poc-desktop"><span class="poc-text">{{$line.RightContent}}</span></td>
		</tr>
	{{else}}
		{{$hasLeft := eq $line.LeftType 3}}
		{{$hasRight := eq $line.RightType 2}}
		{{/* desktop: both sides on one row */}}
		<tr class="poc-line poc-desktop" data-line-type="diff">
			{{if $hasLeft}}
				<td class="poc-num poc-removed">{{$line.LeftIdx}}</td>
				<td class="poc-code poc-removed"><span class="poc-text">{{$line.LeftContent}}</span></td>
			{{else}}
				<td class="poc-num"></td>
				<td class="poc-code"></td>
			{{end}}
			{{if $hasRight}}
				<td class="poc-num poc-side2 poc-added">{{$line.RightIdx}}</td>
				<td class="poc-code poc-added"><span class="poc-text">{{$line.RightContent}}</span></td>
			{{else}}
				<td class="poc-num poc-side2"></td>
				<td class="poc-code"></td>
			{{end}}
		</tr>
		{{/* phones: each side under its own header */}}
		{{if $hasLeft}}
			<tr class="poc-colhead-row poc-mobile"><th colspan="2" class="poc-colhead">{{template "shared/repo/contributor_count" (dict "Count" $Repo1ContributorCount "Label" "title")}}</th></tr>
			<tr class="poc-article-row poc-mobile"><td colspan="2" class="poc-article">{{template "repo/diff/subject_compare_article" $side1}}</td></tr>
			<tr class="poc-line poc-mobile" data-line-type="del">
				<td class="poc-num poc-removed">{{$line.LeftIdx}}</td>
				<td class="poc-code poc-removed"><span class="poc-text">{{$line.LeftContent}}</span></td>
			</tr>
		{{end}}
		{{if $hasRight}}
			<tr class="poc-colhead-row poc-mobile"><th colspan="2" class="poc-colhead">{{template "shared/repo/contributor_count" (dict "Count" $Repo2ContributorCount "Label" "title")}}</th></tr>
			<tr class="poc-article-row poc-mobile"><td colspan="2" class="poc-article">{{template "repo/diff/subject_compare_article" $side2}}</td></tr>
			<tr class="poc-line poc-mobile" data-line-type="add">
				<td class="poc-num poc-added">{{$line.RightIdx}}</td>
				<td class="poc-code poc-added"><span class="poc-text">{{$line.RightContent}}</span></td>
			</tr>
		{{end}}
	{{end}}
{{end}}
