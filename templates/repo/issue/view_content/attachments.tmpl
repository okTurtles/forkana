<div class="dropzone-attachments">
	{{/* An image whose UUID already appears in the rendered content is displayed inline by the
	content itself (the editor inserts "![name](/attachments/{uuid})"), so listing it here again
	would show it twice. Only images that are not embedded get a file row and a thumbnail.

	The filter is deliberately limited to images: a non-image attachment is inserted as a plain
	link, and its file row is the only place that shows the file size and the download icon, so
	it stays listed even when the content links to it. */}}
	{{$renderedContent := StringUtils.ToString .RenderedContent}}
	{{$hasListed := false}}
	{{$hasThumbnails := false}}
	{{- range .Attachments -}}
		{{if not (and (FilenameIsImage .Name) (StringUtils.Contains $renderedContent .UUID))}}
			{{$hasListed = true}}
			{{if FilenameIsImage .Name}}
				{{$hasThumbnails = true}}
			{{end}}
		{{end}}
	{{- end -}}
	{{if $hasListed}}
		<div class="divider"></div>
	{{end}}
	{{- range .Attachments -}}
		{{if not (and (FilenameIsImage .Name) (StringUtils.Contains $renderedContent .UUID))}}
		<div class="tw-flex">
			<div class="tw-flex-1 tw-p-2">
				<a target="_blank" rel="noopener noreferrer" href="{{.DownloadURL}}" title="{{ctx.Locale.Tr "repo.issues.attachment.open_tab" .Name}}">
					{{if FilenameIsImage .Name}}
						{{svg "octicon-image"}}
					{{else}}
						{{svg "octicon-desktop-download"}}
					{{end}}
					<span><strong>{{.Name}}</strong></span>
				</a>
			</div>
			<div class="tw-p-2 tw-flex tw-items-center">
				<span class="ui text grey">{{.Size | FileSize}}</span>
			</div>
		</div>
		{{end}}
	{{end -}}

	{{if $hasThumbnails}}
		<div class="divider"></div>
		<div class="ui small thumbnails">
			{{- range .Attachments -}}
				{{if and (FilenameIsImage .Name) (not (StringUtils.Contains $renderedContent .UUID))}}
				<a target="_blank" rel="noopener noreferrer" href="{{.DownloadURL}}">
					<img loading="lazy" alt="{{.Name}}" src="{{.DownloadURL}}" title="{{ctx.Locale.Tr "repo.issues.attachment.open_tab" .Name}}">
				</a>
				{{end}}
			{{end -}}
		</div>
	{{end}}

</div>
