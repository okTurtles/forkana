{{/* Non-blocking hint shown under a subject input while the typed title breaks the subject
	title rule (modules/subjecttitle, Wikipedia's title restrictions), or when a new subject would
	be saved under a normalized spelling ("iPhone" → "IPhone"). It never blocks submitting: a
	title that breaks the rule is still accepted when it resolves to an existing subject, which
	only the server knows. See web_src/js/features/subject-title-hint.ts. */}}
<span class="help text tw-hidden" data-subject-title-hint
	data-msg-forbidden-char="{{ctx.Locale.Tr "repo.form.subject_title_forbidden_char"}}"
	data-msg-percent-encoding="{{ctx.Locale.Tr "repo.form.subject_title_percent_encoding"}}"
	data-msg-html-entity="{{ctx.Locale.Tr "repo.form.subject_title_html_entity"}}"
	data-msg-tildes="{{ctx.Locale.Tr "repo.form.subject_title_tildes"}}"
	data-msg-relative-path="{{ctx.Locale.Tr "repo.form.subject_title_relative_path"}}"
	data-msg-leading-colon="{{ctx.Locale.Tr "repo.form.subject_title_leading_colon"}}"
	data-msg-too-long="{{ctx.Locale.Tr "repo.form.subject_title_too_long" .SubjectTitleMaxBytes}}"
	data-msg-normalized="{{ctx.Locale.Tr "repo.form.subject_title_normalized" "%s"}}"
></span>
